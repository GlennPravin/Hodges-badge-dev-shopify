<script>
  (function() {
      try{
      if(!localStorage.getItem('afterWiser')){
        let arr = ["wis_customer_browsed","wisede_browse","wi_colbrowse_data","__wsCartStatus","wi_related_browse","wi_recent_products","wsMoneyFormat","evm_wiser_productids","evm_wiser_page","evm_wiser_template","evm_wiser_widget","evm_product_collection","evm_add_to_cart","evm_productwithvariant_collection","evm_cart_collection","evm_add_to_cart"];
          let localArr = Object.keys(localStorage);
          localArr.forEach((x)=>{
              if(arr.includes(x)||x.includes('wisede_browse') )
              localStorage.removeItem(x);
          })
          localStorage.setItem('afterWiser',true)
      }
    } catch(error){
      console.log('error',error.message)
    }
  })()
  </script>