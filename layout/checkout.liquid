    <script>

      (function($) {

        $(document).on("page:load page:change", function() {

            $('#error-for-reduction_code').text("Enter a valid key code"); 
  
           if ('{{shop.metafields.Keycode.notification.isEnabled}}' == 'true') {
              $('#keyAlert').remove();
              $(".order-summary__section--discount").prepend('<span id="keyAlert" style="font-weight: bold;">{{shop.metafields.Keycode.notification.Description }}</span>')
            } 
           
           $('#checkout_shipping_address_address1').change(function() {   
                  let postring = '{{shop.metafields.POBoxKeywords.keywords | join: ", "}}';
                  let poArr = postring.split(',');
                   $('#spAddress1').remove();
                   $(poArr).each((index, po) => {  
                  if ( $('#checkout_shipping_address_address1').val().toLowerCase().includes(po.toLowerCase())) 
                    {                     
                       $('#checkout_shipping_address_address1').parent().append('<span id="spAddress1" style="color:red">We can not ship to a PO Box. Please enter street address</span>')
                       $('#checkout_shipping_address_address1').val('')
                       $('#checkout_shipping_address_address1').focus();
                        return false;
                    }                                
                    
                  });
                  
                });
                 $('#checkout_shipping_address_address2').change(function() {   
                   let postring = '{{shop.metafields.POBoxKeywords.keywords | join: ", "}}';
                  let poArr = postring.split(',');
                   $('#spAddress2').remove();
                   $(poArr).each((index, po) => {  
                  if ( $('#checkout_shipping_address_address2').val().toLowerCase().includes(po.toLowerCase())) 
                    {
                      $('#checkout_shipping_address_address2').parent().append('<span id="spAddress2" style="color:red">We can not ship to a PO Box. Please enter street address</span>')
                       $('#checkout_shipping_address_address2').val('')
                       $('#checkout_shipping_address_address2').focus();
                        return false;
                    }                                
                    
                  });
                  
                });
           $(window).on("load", function() {
          $(".product__description__property.order-summary__small-text").filter(function() {
            const previewicon = {{shop.metafields.PreviewIcon | json }};
               if( $(this).text().split(':')[0].includes('CustomDesign'))
               {
                 let _text = $(this).text().split(':')[0].trim().toString(); 
               {% comment %}  let _src = $(this).text().split(':')[1].trim().toString(); {% endcomment %}
                  let _src = $(this).text().replace(_text + ":", "");
                let extension = _src
                .split(/[#?]/)[0]
                .split('.')
                .pop()
                .trim();
              extension = 0 + extension;
               let preview = previewicon[extension];
                  $(this).text(_text);
                   if (preview) {
                     $(this).append('<img src="' + preview + '"  width="100">');
                     } else {
                  $(this).append('<img src="'+_src+'"  width="100">');
                     }
               }
               
            });
	});

          $(".total-line--taxes th").text('Estimated Taxes');
          if ($('#shipDate').length == 0) 
            $("#main-header").after('</br><div id="shipDate"  data-toggle="tooltip" data-placement="top" title= "                 {{shop.metafields.helpText.deliveryDate}}" >Delivery Date:                  {{ checkout.line_items[0].properties["_deliveryDate"] }} <i class="fa fa-info-circle" style="font-size:16px;color:#ae1a1a"></i></div> ');
          
         

          if ($('#shipDate').length > 0) {
            $("#shipDate").hide();

// $(".section--shipping-method .small-text").show();     
            if (Shopify.Checkout.step == 'shipping_method') {
              $(".section--shipping-method .small-text").filter(function() {
