                  $(this).css("color", "red");
                }
                $(this).text(shipmethods[$(this).parent().attr('data-shipping-method-label-title')]);
              });

// $(".section--shipping-method .small-text").text($(".section--shipping-method .small-text").parent().text());
// $(".section--shipping-method .small-text").hide();   
              $("#shipDate").show();
            }

          }
          // if(Shopify.Checkout.step == 'payment_method'){
