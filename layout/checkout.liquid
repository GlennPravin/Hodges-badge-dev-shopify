        function mergeAddChargeWithProducts() {
          let prop;
          let totalAC;
          let baseAC;
          let merchandiseTotal = 0;
          let sepupCharge = 0;
          let moaCharge = 0;
          let ppCharge = 0;
          let dieCharge = 0;
          let logoCharge = 0;
          let qty = 0;
          let variantIds = [];
          let imgElement;
          let canvasProp;
          let canvasImage;
          let totalPrice = 0;
          const previewicon = {{shop.metafields.PreviewIcon | json }};
          let discount_percentage = {{ shop.metafields.Discount.percentage}}
		  {%- for lineitem in checkout.line_items -%}
		  if ('{{lineitem.product.type}}' == "HiddenCharges") {

              if ('{{lineitem.product.title}}'.includes('Setup Charges')) {
                sepupCharge += {{lineitem.original_price}};
                totalPrice +=  {{lineitem.original_price}}/100;
              }
              if ('{{lineitem.product.title}}'.includes('Minimum Order')) {
                moaCharge += {{lineitem.final_price}};
              }
              if ('{{lineitem.product.title}}'.includes('Premium Processing')) {
                
                ppCharge += ({{lineitem.final_price}} * {{lineitem.quantity}});
              }
              if ('{{lineitem.product.title}}'.includes('Flat Charges')) {

                if ('{{lineitem.properties['ChargeType']}}'.includes('Die')) {
                  dieCharge += {{lineitem.original_price}} * {{lineitem.quantity}};
                  totalPrice +=  {{lineitem.original_line_price}}/100;

                }
                if ('{{lineitem.properties['ChargeType']}}'.includes('Logo')) {
                  logoCharge += ({{lineitem.original_price}} * {{lineitem.quantity}});
                  totalPrice +=  {{lineitem.original_line_price}}/100;
                }


              }

            }

            if ('{{lineitem.product.type}}' !== "HiddenCharges") {

              prop = {{lineitem.properties | json}};
			  canvasProp = prop;
              totalAC = prop.filter(function(p) {
                return p[0] == "_totalAc";
              });
              baseAC = prop.filter(function(x) {
                return x[0] == "_baseAc";
              })
              let itemAc = 0;
	      let itemBc = 0;
              if (totalAC.length > 0) {
                itemAc = totalAC[0][1] * 100;
              }
		if (totalAC.length > 0) {
                itemBc = baseAC[0][1];
              }
              qty = {{lineitem.quantity}};
              let itemPrice = {{lineitem.original_price}} * qty;

              // let finalPrice = ((itemPrice + itemAc) / 100);
              let finalPrice = ((itemPrice) / 100);
              
              let spPrice = '$' + finalPrice.toFixed(2).toString();
              let variable ={}
              canvasProp.forEach(function(i) {
                variable[i[0]]=i[1];
              });
              let obj = Object.keys(variable);
            //   var value = obj.filter((i)=> i.includes("_CustomDesign") || i.includes("_CustomDesignCenter"))
            //   console.log(value)
            //   console.log(variable[value])

              var varIds = variantIds.filter(v => v == {{lineitem.variant_id}});

              let spanPrice = $("tr[data-variant-id='{{lineitem.variant_id}}']").find(".product__price span")[varIds.length];
              variantIds.push({{lineitem.variant_id}});
              $(spanPrice).text(spPrice);
              
			  let Price = $("tr[data-variant-id='{{lineitem.variant_id}}']").find(".product__description .product__description__name.order-summary__emphasis")[varIds.length];
              let productPrice = {{lineitem.original_price}}/100;
              // if(itemBc){
              //   base = productPrice + parseFloat(itemBc);
              //   productPrice = base.toFixed(2)
              // } 
               if($("span.reduction-code").length > 0 && $("li.reduction-code").length > 0 ){
                // if($(Price).next(".product__description__property.order-summary__small-text[style='font-weight: 700; color: #01bddd;']").length == 0){
                $(Price).after("<span class='product__description__property order-summary__small-text'style='font-weight: 700; color: #01bddd;' >Price : $" + productPrice + "</span>")
                // }
                if (variable['_canvasImage']) {
                  imgElement = $(Price).parent().prev().find('.product-thumbnail__image');
                  $(imgElement).attr('src', variable['_canvasImage']);
                } 
                if(variable["_CustomDesignCenter"] || variable["_CustomDesign"] ){
                 let value =  variable["_CustomDesignCenter"] != undefined ?  "_CustomDesignCenter":"_CustomDesign"
                 let extension = variable[value].split(/[#?]/)[0].split('.').pop().trim();
               extension = 0 + extension;
                              let preview = previewicon[extension] ?? variable[value];
                  const $span = $('<span>', {
                              class: 'product__description__property order-summary__small-text',
                              text: value.split("_")[1] 
                            });
                  const $img = $('<img>', {
                    src: preview, 
                    width: 100 
                  });
                  $span.append($img);
                 $(Price).parent().append($span)
               }
              } else{
              $(window).on("load", function() {
                // if($(Price).next(".product__description__property.order-summary__small-text[style='font-weight: 700; color: #01bddd;']").length == 0){
                $(Price).after("<span class='product__description__property order-summary__small-text'style='font-weight: 700; color: #01bddd;' >Price : $" + productPrice + "</span>")
                // }
                if (variable['_canvasImage']) {
                  imgElement = $(Price).parent().prev().find('.product-thumbnail__image');
                  $(imgElement).attr('src', variable['_canvasImage']);
                } 
                if(variable["_CustomDesignCenter"] || variable["_CustomDesign"] ){
                let value =  variable["_CustomDesignCenter"] != undefined ?  "_CustomDesignCenter":"_CustomDesign"
                let extension = variable[value].split(/[#?]/)[0].split('.').pop().trim();
               extension = 0 + extension;
               let preview = previewicon[extension] ?? variable[value];
                const $span = $('<span>', {
                              class: 'product__description__property order-summary__small-text',
                              text: value.split("_")[1] 
                            });
                  const $img = $('<img>', {
                    src: preview, 
                    width: 100 
                  });
                  $span.append($img);
                 $(Price).parent().append($span)
               }
                  });
                }
              merchandiseTotal += finalPrice;

            }


          {% endfor %}

          let merTotal = '$' + merchandiseTotal.toFixed(2).toString();
          $(".total-line--subtotal .total-line__name").text("Merchandise Total")
          $(".total-line--subtotal .total-line__price span").text(merTotal)
          console.log('subtotal', $(".total-line--subtotal .total-line__name").text())


         if($("span.reduction-code").length > 0 || $("li.reduction-code").length > 0 ){
            if( $(".total-line--discountprice").length == 0){
              let discount = (totalPrice + merchandiseTotal) * (discount_percentage/100)
              // addOrtherChargesInSummary('( -$'+ Math.floor(discount * 100) / 100  +' )', "Total Discount", Math.floor(discount * 100) / 100, "discountprice");
              $("li.reduction-code").each((index, ele) => {
              $(ele).hide();
              });
              $("del.order-summary__small-text").each((index,ele)=>{
                $(ele).next().hide();
                $(ele).hide();
              })
              }
          }else{
            $(".total-line--discountprice").remove();
          }
          if (ppCharge > 0) {
             var tag_button = document.getElementsByClassName('tag__button');
              if (tag_button.length > 0) {
                document.querySelector('.tag__button').click();
              }   
            $(".order-summary__section--discount").hide();
            let ppAmnt = '$' + (
              ppCharge / 100
            ).toFixed(2).toString();
            addOrtherChargesInSummary(ppAmnt, "Premium Processing Charges", ppCharge, "ppCharge");
          }

          if (moaCharge > 0) {
            let moaAmnt = '$' + (
              moaCharge / 100
            ).toFixed(2).toString();
            addOrtherChargesInSummary(moaAmnt, "Minimum Order Charges", moaCharge, "moaCharge");
          }

          if (sepupCharge > 0) {
            let setAmnt = '$' + (
              sepupCharge / 100
            ).toFixed(2).toString();
            addOrtherChargesInSummary(setAmnt, "Setup Charges", sepupCharge, "setupCharge");
          }

          if (dieCharge > 0) {
            let dieAmnt = '$' + (
              dieCharge / 100
            ).toFixed(2).toString();
            addOrtherChargesInSummary(dieAmnt, "Die Charges", dieCharge, "dieCharge");
          }

          if (logoCharge > 0) {
            let logoAmnt = '$' + (
              logoCharge / 100
            ).toFixed(2).toString();
            addOrtherChargesInSummary(logoAmnt, "Logo Charges", logoCharge, "logoCharge");
          }

          if (merchandiseTotal > 0) {
            $(".total-line--subtotal").hide();
            addOrtherChargesInSummary(merTotal, "Merchandise Total", merchandiseTotal * 100, "MerchandiseTotal");
          }
        //   let defaultAddresCount = {{ customer.addresses_count }}
        //   if(defaultAddresCount > 1){
        //   $('.field__input--select').val('');
        //   $('.address-fields input[type="text"]').val('');
        //   }

          

        }

        function hideHiddenChargeProducts() {
          $(".product__description__variant").hide();
          $("tr[data-product-type='HiddenCharges']").hide();

          $(".product__description__property").filter(function() {
            if ($(this).text().indexOf('Base Additional Charge') > -1) 
              $(this).hide();
            



            if ($(this).text().indexOf('.~') > -1) {

              $(this).text($(this).text().split('.~')[1]);
            }
          });

        }

        function addOrtherChargesInSummary(amount, title, amounttarget, amountClass) {

          let $tr = $("tr.total-line--subtotal");

          let trAddChrg = ({amnt, titl, amnttarget, amntClass}) => `<tr class="total-line total-line--${amntClass}">
            <th class="total-line__name" scope="row">${titl}</th>
            <td class="total-line__price">
                <span class="order-summary__emphasis skeleton-while-loading" data-checkout-${amntClass}-price-target="${amnttarget}">
                   ${amnt}
                </span>
            </td>
        </tr>`;
          $tr.after([{
              amnt: amount,
              titl: title,
              amnttarget: amounttarget,
              amntClass: amountClass
            }].map(trAddChrg).join(''));

        }
 
      })(Checkout.$);
    </script>
<script>
    try {
        fetch('/cart.json')
            .then(response => response.json()) // convert to json
            .then(function (json) {
                var eci_products = [];
                var eci_subtotal = json.total_price / 100;
                json.items.forEach(function (i, index) {
                    if (i.handle != "premium-processing-charges") {
                        eci_products.push({
                            item_id: i.product_id,
                            item_name: i.title,
                            affiliation: "Hodges Badge",
                            currency: "USD",
                            index: index,
                            price: i.price / 100,
                            quantity: i.quantity
                        });
                    }
                })
                if (Shopify.Checkout.step == "contact_information") {
                    gtag("event", "begin_checkout", {
                        currency: "USD",
                        value: eci_subtotal,
                        items: eci_products
                    });
                }
                document.addEventListener("click", function (e) {

                    var tgt = e.target;
                    if (Shopify.Checkout.step == "shipping_method" && tgt.id == "continue_button") {
                        gtag("event", "add_shipping_info", {
                            currency: "USD",
                            value: eci_subtotal,
                            shipping_tier: document.querySelector('.input-radio:checked').closest(
                                    '.content-box__row').querySelector('.radio__label__primary')
                                .getAttribute('data-shipping-method-label-title'),
                            items: eci_products
                        });
                    }
                    if (Shopify.Checkout.step == "payment_method" && tgt.id == "continue_button") {
                        gtag("event", "add_payment_info", {
                            currency: "USD",
                            value: eci_subtotal,
                            payment_type: "Credit Card",
                            items: eci_products
                        });
                    }
                })

            }) //print data to console
            .catch(err => console.log('Request Failed', err));
    } catch (err) {}
</script>
