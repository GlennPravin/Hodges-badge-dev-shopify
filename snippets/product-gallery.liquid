                  {%- if shopifyAlternateImages.size > 0 -%}
                      {%- assign counter = 0 -%}
                      {%- assign rendered_media_ids = "," -%}
                      {%- for media in product.media -%}
                          {%- for image in product.images -%}
                         
                              {%- if image.src == media -%}
                                  {%- for Hops_media in shopifyAlternateImages -%}
    
                                      {% assign imageId = image.id | append: "" %}
                                      {% assign mediaImageId = media.id | append: "" %}
                                      {% assign hopsImageSrc = Hops_media.imageSrc | append: "" %}
                                      {%- assign hops_id_match = false -%}
                                      {%- if imageId == hopsImageSrc or mediaImageId == hopsImageSrc -%}
                                          {%- assign hops_id_match = true -%}
                                      {%- endif -%}
                                      {%- assign media_id_token = "," | append: media.id | append: "," -%}
                                      {%- if hops_id_match or forloop.last -%}
                                          {%- if hops_id_match -%}
                                              {%- if counter == 0 -%}
                                                  {%- if Hops_media.marketId == itemShow -%}
                                                      {%- assign selected_media = media -%}
                                                      {%- assign counter = 1 -%}
                                                  {%- endif -%}
                                              {%- endif -%}
                                          {%- endif -%}
                                          {%- unless rendered_media_ids contains media_id_token -%}
                                          {%- assign rendered_media_ids = rendered_media_ids | append: media.id | append: "," -%}
                                          {%- assign is_media_group = false -%}
                                          {%- assign is_media_filtered = false -%}
                                          {%- assign media_alt = media.alt -%}
                                          {%- if media.alt contains '#' -%}
                                              {%- assign is_media_group = true -%}
                                              {%- assign alt_parts = media.alt | split: '#' -%}
    
                                              {%- comment -%}
                                            If the custom ALT tag contains two parts (for instance "My custom alt # color_blue") then the first part is actually used
                                            as a custom ALT tag
                                            {%- endcomment -%}
    
                                              {%- if alt_parts.size == 2 and alt_parts.first != blank -%}
                                                  {%- assign media_alt = alt_parts.first | strip -%}
                                              {%- else -%}
                                                  {%- assign media_alt = product.title -%}
                                              {%- endif -%}
    
                                              {%- assign media_group_parts = alt_parts.last | split: '_' -%}
    
                                              {%- for option in product.options -%}
                                                  {%- assign downcase_option = option | downcase -%}
                                                  {%- assign downcase_group_option = media_group_parts.first | strip | downcase -%}
    
                                                  {%- if downcase_option == downcase_group_option -%}
                                                      {%- assign option_setting = 'option' | append: forloop.index -%}
                                                      {%- assign option_value = product.selected_or_first_available_variant[option_setting] | downcase -%}
    
                                                      {%- assign downcase_group_value = media_group_parts.last | strip | downcase -%}
                                                      {%- assign media_variant_ids = media.variants | map: 'id' -%}
    
                                                      {%- if option_value != downcase_group_value -%}
                                                          {%- unless media_variant_ids contains product.selected_or_first_available_variant.id -%}
                                                              {%- assign is_media_filtered = true -%}
                                                          {%- endunless -%}
                                                      {%- endif -%}
    
                                                      {%- break -%}
                                                  {%- endif -%}
                                              {%- endfor -%}
                                          {%- endif -%}
    
                                          <div class="product-gallery__carousel-item image_hide {% if media.id == selected_media.id %}is-selected{% endif %} {% if is_media_filtered %}is-filtered{% endif %}" tabindex="-1" data-media-id="{{ media.id }}" data-media-type="{{ media.media_type | escape }}" {% if media.media_type == 'external_video' %} data-media-host="{{ media.host | escape }}" data-video-id="{{ media.external_id | escape }}" {% endif %} {% if is_media_group %} data-group-name="{{ media_group_parts.first | strip | downcase | escape }}" data-group-value="{{ media_group_parts.last | strip | downcase | escape }}" {% endif %}>
                                              {%- case media.media_type -%}
