    <script>
      (function () {
        var imageDebug = {
          handle: {{ product.handle | json }},
          title: {{ product.title | json }},
          mediaCount: {{ product.media.size | json }},
          canvasEnabled: {{ canvasEnabled | json }},
          alternateImagesCount: {{ shopifyAlternateImages.size | default: 0 | json }},
          imageBranch: {% if shopifyAlternateImages.size > 0 %}"shopifyAlternateImages"{% else %}"default-product-media"{% endif %},
          itemShow: {{ itemShow | json }},
          productImages: [
            {%- for image in product.images -%}
              {"id":{{ image.id | append: "" | json }},"src":{{ image.src | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          productMedia: [
            {%- for media in product.media -%}
              {"id":{{ media.id | append: "" | json }},"type":{{ media.media_type | json }},"previewSrc":{{ media.preview_image.src | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          alternateImages: [
            {%- if shopifyAlternateImages.size > 0 -%}
              {%- for Hops_media in shopifyAlternateImages -%}
                {"imageSrc":{{ Hops_media.imageSrc | append: "" | json }},"marketId":{{ Hops_media.marketId | append: "" | json }}}{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          ],
          liquidChecks: [
            {%- for image in product.images -%}
              {%- assign imageId = image.id | append: "" -%}
              {%- assign srcMatchedMedia = false -%}
              {%- assign matchedMediaId = "" -%}
              {%- for media in product.media -%}
                {%- if image.src == media -%}
                  {%- assign srcMatchedMedia = true -%}
                  {%- assign matchedMediaId = media.id | append: "" -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign idMatchedAlt = false -%}
              {%- assign mediaIdMatchedAlt = false -%}
              {%- if shopifyAlternateImages.size > 0 -%}
                {%- for Hops_media in shopifyAlternateImages -%}
                  {%- assign hopsImageSrc = Hops_media.imageSrc | append: "" -%}
                  {%- if imageId == hopsImageSrc -%}
                    {%- assign idMatchedAlt = true -%}
                  {%- endif -%}
                  {%- if matchedMediaId != blank and matchedMediaId == hopsImageSrc -%}
                    {%- assign mediaIdMatchedAlt = true -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {"imageId":{{ imageId | json }},"mediaId":{{ matchedMediaId | json }},"srcEqualsMedia":{{ srcMatchedMedia | json }},"legacyIdMatch":{{ idMatchedAlt | json }},"mediaIdMatch":{{ mediaIdMatchedAlt | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        };
        console.log("[PRODUCT IMAGE DEBUG] liquid", imageDebug);
        console.log("[PRODUCT IMAGE DEBUG] product image ids", imageDebug.productImages.map(function (img) { return img.id; }));
        console.log("[PRODUCT IMAGE DEBUG] metafield imageSrc", imageDebug.alternateImages.map(function (alt) { return alt.imageSrc; }));
        console.log("[PRODUCT IMAGE DEBUG] URL sort_by itemShow =", JSON.stringify(imageDebug.itemShow));

        if (imageDebug.imageBranch !== "shopifyAlternateImages") {
          console.log("[PRODUCT IMAGE DEBUG] metafield filter OFF. Theme uses product.media directly.");
        } else {
          imageDebug.liquidChecks.forEach(function (check) {
            if (check.legacyIdMatch) {
              console.log("[PRODUCT IMAGE DEBUG] MATCH legacy image id", check.imageId);
            } else if (check.mediaIdMatch) {
              console.log("[PRODUCT IMAGE DEBUG] MATCH media image id", check.mediaId);
            } else if (imageDebug.alternateImages.length) {
              console.warn("[PRODUCT IMAGE DEBUG] NO MATCH legacy or media id", {
                legacyImageId: check.imageId,
                mediaImageId: check.mediaId,
                metafieldImageSrcList: imageDebug.alternateImages.map(function (alt) { return alt.imageSrc; })
              });
            }
          });
        }

        function inspectGallery() {
          var slides = document.querySelectorAll(".product-gallery__carousel-item");
          console.log("[PRODUCT IMAGE DEBUG] DOM slides:", slides.length);
          if (!slides.length) {
            console.warn("[PRODUCT IMAGE DEBUG] no carousel slides rendered — image will be blank");
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", inspectGallery);
        } else {
          inspectGallery();
        }
      })();
    </script>