{%- assign maxQty = shop.metafields.MaxqtyVolumeInSite.fromQty -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign color_label = 'color,colour,couleur,cor,colore,farbe,색,色,カラー,färg,farve,szín,barva' | split: ',' -%}
{%- if product.metafields.PriceInfo.QuantityRangePrices.value -%}
  {%- assign quantity_range_prices = product.metafields.PriceInfo.QuantityRangePrices.value -%}
{%- elsif product.metafields.PriceInfo.QuantityRangePrices.value -%}
  {%- assign quantity_range_prices = product.metafields.PriceInfo.QuantityRangePrices.value -%}
{%- else -%}
  {%- assign quantity_range_prices = '{}' | json -%}
{%- endif -%}

{% assign SubType = product.metafields.ProductMeta.ProductAdditionalInfo.value.ExtraInfoAboutProduct.ProductSubType  %}
{% assign stockCustomRider = shop.metafields.stockCustomRider.SubType | split:',' %}

    {% for subTypeId in stockCustomRider %}
    {% assign subId = subTypeId | plus:0 %}
    {%- if subId == SubType -%}
    {% assign isCustomRideQty = true %}
        {%- continue -%}
    {%- endif -%}
    {% endfor %} 

{%- assign RemoveBuyButton =  shop.metafields.helpText.RemoveAddtoCartButton.value -%}
{%- assign ProductIDs =  product.metafields.search.productId.value  -%}
{%- unless product.has_only_default_variant -%}
  <div class="product-form__variants" {{ block.shopify_attributes }}>
    
    {%- render 'product-info-variant-selector', product: product, form: form, block: block -%}

    {%- if quantity_range_prices.isStreamerAvailable == true -%}
       {% unless RemoveBuyButton contains ProductIDs %}
      <div class="">
          {%- capture option_name -%}{{ section.id }}-{{ product.id }}-"streamer-size"{%- endcapture -%}
          {%- assign streamer_size = quantity_range_prices.quantityRange -%}
         
          <div class="product-form__option  info-option" data-selector-type="select">
              <label class="product-form__option-name text--strong" for="streamer-size" class="">Streamer Size: {% if streamer_size['isRequired'] %} * {% endif %}</label>
              <select class="" data-label="Streamer Size" name="{{quantity_range_prices.OptionId}}" id="streamer-size" {% if streamer_size['isRequired'] %} required {% endif %} {% if streamer_size.optionMessage %} data-toggle="tooltip" data-placement="top" title="{{ streamer_size.optionMessage }}" data-html="true" {% endif %} >
                  <option value="" selected>- Select an Option - </option>
                   {%- assign common_option = shop.metafields.CommonOptions[quantity_range_prices.OptionId].value.values -%}
                  {%- for streamer_option in common_option -%}
                  <option value="{{ streamer_option.id | escape }}" {% if forloop.index ==1 %} selected {% endif %} >{{ streamer_option.name | escape }}</option>
                  {%- endfor -%}
              </select>
              <div class="error streamer-size"></div>
          </div>
         
      </div>
       {%- endunless -%} 

      {%- assign streamer_size = quantity_range_prices.quantityRange -%}
      {%- for streamer_option in streamer_size -%}
      {%- assign quantity_price = quantity_range_prices.StreamerSizes[streamer_option.id] -%}
      {%- assign price_options_available = quantity_price.size -%}
      <div class="quantity-price-section {% if forloop.index == 1 %} show {% endif %} " data-streamer-id="{{ streamer_option.id }}" >
          <span class="product-form__option-name text--strong pricing-label">Qty/Price: </span>
          <div class="block-swatch-list pricing-swatch-list" {% if streamer_option.optionMessage %} data-toggle="tooltip" data-placement="top" title="{{ streamer_option.optionMessage }}" data-html="true" {% endif %} >
              {%- for quantity_price_slot in quantity_price -%}
              {% if forloop.index == forloop.length %}
               <div class="block-swatch-alias pricing-swatch-alias  {% if price_options_available >=6 %}fix_width {% endif %} {% if price_options_available <= 6  %} width_size {% endif %}  {% if price_options_available <= 5 %} set_minimum_five {% endif %}"  style="{% if price_options_available < 5 %} min-width: 80px; {% endif %} " >  
                <label class="block-swatch__item quantity-pricing" for="{{ block_swatch_id }}"
                    title="{{quantity_price_slot.BaseSellPrice | escape}}">
                <span class="block-swatch__item-text">{{quantity_price_slot.FromQty | round }} +</span><hr />                
                <span class="block-swatch__item-text price">{{quantity_price_slot.BaseSellPrice | money}}</span><br>
                 {% if quantity_price_slot.SalePrice > quantity_price_slot.BaseSellPrice %}
                          <span  style="text-decoration: line-through; color: red;">
                            <span class="block-swatch__item-text price" style="font-size:small">{{quantity_price_slot.SalePrice | money}}</span>
                          </span>
                          {% comment %} <br><strike>{{quantity_price_slot.SalePrice | money}}</strike> {% endcomment %}
                       {% endif %} 
                
              </label>
            </div>
                {% break %} 
              {% else %} 
               <div class="block-swatch-alias pricing-swatch-alias  {% if price_options_available >= 6 %}fix_width {% endif %} {% if price_options_available <= 6 %} width_size {% endif %}  {% if price_options_available <= 5 %} set_minimum_five {% endif %}"  style="{% if price_options_available < 5 %} min-width: 80px; {% endif %} " >  
                <label class="block-swatch__item quantity-pricing" for="{{ block_swatch_id }}"
                    title="{{quantity_price_slot.BaseSellPrice | escape}}">
                <span class="block-swatch__item-text">{{quantity_price_slot.FromQty | round }} - {{quantity_price_slot.ToQty | round }}</span>
                <hr /><span class="block-swatch__item-text price">{{quantity_price_slot.BaseSellPrice | money}}</span><br>
                {% if quantity_price_slot.SalePrice > quantity_price_slot.BaseSellPrice %}
                          <span style="text-decoration: line-through; color: red;">
                            <span class="block-swatch__item-text price" style="font-size:small">{{quantity_price_slot.SalePrice | money}}</span>
                          </span>
                          {% comment %} <br><strike>{{quantity_price_slot.SalePrice | money}}</strike> {% endcomment %}
                       {% endif %} 
              </label>
            </div>
              {% endif %} 
           
              
              {%- endfor -%}
          </div>
      </div>
      {%- endfor -%}
      {%- else quantity_range_prices.isStreamerAvailable == false -%}
      {%- assign quantity_range_options = quantity_range_prices.quantityRange -%}
      {%- assign price_options_available = quantity_range_options.size -%}
      <div class="product-form__option  info-option" data-selector-type="block" data-streamer-size="{{ streamer_option.id }}">
          <span class="product-form__option-name text--strong pricing-label">Qty/Price: </span>
          <div class="block-swatch-list pricing-swatch-list" {% if streamer_option.optionMessage %} data-toggle="tooltip" data-placement="top" title="{{ streamer_option.optionMessage }}" data-html="true" {% endif %} >
              {%- for quantity_price_slot in quantity_range_options -%}
            {%- assign width_size = price_options_available -%}
              {%- capture block_swatch_id -%}{{quantity_price_slot.baseSellPrice}}-{{forloop.index}}{%- endcapture -%}
              <!-- <div class="block-swatch-alias pricing-swatch-alias" style="width: calc(100% / {{price_options_available}}); {% if price_options_available < 5 %} min-width: 100px; {% endif %}" > 
                  <label class="block-swatch__item quantity-pricing" for="{{ block_swatch_id }}"
                      title="{{quantity_price_slot.BaseSellPrice | escape}}"> -->
                      <!-- <span class="block-swatch__item-text">
                        {{quantity_price_slot.FromQty | round}} -
                          {{quantity_price_slot.ToQty | round}}</span>
                      <hr />
                      <span class="block-swatch__item-text price">{{quantity_price_slot.BaseSellPrice | money}}</span> -->
                    {% if forloop.index == forloop.length %}
                     <div class="block-swatch-alias pricing-swatch-alias  {% if price_options_available >= 6 %}fix_width {% endif %} {% if price_options_available  <= 6 %} width_size {% endif %}  {% if price_options_available <= 5 %} set_minimum_five {% endif %}"  style="{% if price_options_available < 5 %} min-width: 80px; {% endif %} " >  
                      <label class="block-swatch__item quantity-pricing" for="{{ block_swatch_id }}"
                          title="{{quantity_price_slot.BaseSellPrice | escape}}">
                      <span class="block-swatch__item-text">{{quantity_price_slot.FromQty | round }} +</span><hr />
                      <span class="block-swatch__item-text price">{{quantity_price_slot.BaseSellPrice | money}}</span>
                       {% if quantity_price_slot.SalePrice > quantity_price_slot.BaseSellPrice %}
                          <span style="text-decoration: line-through; color: red;">
                            <span class="block-swatch__item-text price" style="font-size:small">{{quantity_price_slot.SalePrice | money}}</span>
                          </span>
                          {% comment %} <br><strike>{{quantity_price_slot.SalePrice | money}}</strike> {% endcomment %}
                       {% endif %} 
                    </label>
                     
                     
                  </div>
                      {% break %} 
                    {% else %} 
                    <div class="block-swatch-alias pricing-swatch-alias  {% if price_options_available >= 6 %}fix_width {% endif %} {% if price_options_available <= 7 %} width_size {% endif %} {% if price_options_available <= 5 %} set_minimum_five {% endif %}"  style="{% if price_options_available < 5 %} min-width: 80px; {% endif %} " >  
                      <label class="block-swatch__item quantity-pricing" for="{{ block_swatch_id }}"
                          title="{{quantity_price_slot.BaseSellPrice | escape}}">
                      <span class="block-swatch__item-text">{{quantity_price_slot.FromQty | round }} - {{quantity_price_slot.ToQty | round }}</span>
                      <hr /><span class="block-swatch__item-text price">{{quantity_price_slot.BaseSellPrice | money}}</span>
                     
                          {% if quantity_price_slot.SalePrice > quantity_price_slot.BaseSellPrice %}
                          <span  style="text-decoration: line-through; color: red;">
                            <span class="block-swatch__item-text price" style="font-size:small" >{{quantity_price_slot.SalePrice | money}}</span>
                          </span>
                          {% comment %} <br><strike>{{quantity_price_slot.SalePrice | money}}</strike> {% endcomment %}
                       {% endif %} 
                       
                    </label>
                                 </div>
                    {% endif %} 
                  <!-- </label>
              </div> -->
              {%- endfor -%}
          </div>
      </div>
      
      {%- endif -%}
    
    <hr/>
    {% unless RemoveBuyButton contains ProductIDs %}
    {%- render 'product-info-common-options', product: product, form: form, block: block -%}

    <hr/>

    {%- render 'product-info-sequence-options', product: product, form: form, block: block -%}
    <div class="no-js product-form__option">
      <label class="product-form__option-name text--strong" for="product-select-{{ product.id }}">{{ 'product.form.variant' | t }}</label>
      <div class="select-wrapper select-wrapper--primary">
        <select id="product-select-{{ product.id }}" name="id">
          {%- for variant in product.variants -%}
            <option {% if variant == selected_variant %}selected="selected"{% endif %} {% unless variant.available %}disabled="disabled"{% endunless %} value="{{ variant.id }}" data-sku="{{ variant.sku }}">{{ variant.title }} - {{ variant.price | money }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>
    {%- endunless -%}
  </div>
{%- else -%}
  <input type="hidden" name="id" data-sku="{{ selected_variant.sku }}" value="{{ selected_variant.id }}">
{%- endunless -%}
{% unless RemoveBuyButton contains ProductIDs %}

<div class="product-form__info-list">
  <div class="product-form__info-item hide">
    <span class="product-form__info-title text--strong">{{ 'product.form.price' | t }}:</span>

    <div class="product-form__info-content" role="region" aria-live="polite">
      <div class="price-list">
        {%- if selected_variant.compare_at_price > selected_variant.price -%}
          <span class="price price--highlight">
            <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>

            {%- if settings.currency_code_enabled -%}
              {{- selected_variant.price | money_with_currency -}}
            {%- else -%}
              {{- selected_variant.price | money -}}
            {%- endif -%}
          </span>

          <span class="price price--compare">
            <span class="visually-hidden">{{ 'product.general.regular_price' | t }}</span>

            {%- if settings.currency_code_enabled -%}
              {{- selected_variant.compare_at_price | money_with_currency -}}
            {%- else -%}
              {{- selected_variant.compare_at_price | money -}}
            {%- endif -%}
          </span>
        {%- else -%}
          <span class="price">
            <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>

            {%- if settings.currency_code_enabled -%}
              {{- selected_variant.price | money_with_currency -}}
            {%- else -%}
              {{- selected_variant.price | money -}}
            {%- endif -%}
          </span>
        {%- endif -%}
      </div>

      <div class="product-form__price-info" style="display: {% if selected_variant.unit_price_measurement %}block{% else %}none{% endif %}">
        <div class="unit-price-measurement">
          <span class="unit-price-measurement__price">{{ selected_variant.unit_price | money }}</span>
          <span class="unit-price-measurement__separator">/ </span>

          <span class="unit-price-measurement__reference-value" {%- if selected_variant.unit_price_measurement.reference_value == 1 -%}style="display: none"{% endif %}>
            {{- selected_variant.unit_price_measurement.reference_value -}}
          </span>

          <span class="unit-price-measurement__reference-unit">{{ selected_variant.unit_price_measurement.reference_unit }}</span>
        </div>
      </div>

      {{- form | payment_terms -}}

      {%- if block.settings.show_taxes_included -%}
        {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
          <p class="product-form__price-info">
            {%- if cart.taxes_included -%}
              {{ 'product.general.include_taxes' | t }}
            {%- endif -%}

            {%- if shop.shipping_policy.body != blank -%}
              {{ 'product.general.shipping_policy_html' | t: link: shop.shipping_policy.url }}
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {%- if block.settings.show_inventory_quantity and product.template_suffix != 'pre-order' -%}
    <div class="product-form__info-item">
      <span class="product-form__info-title text--strong">{{ 'product.form.inventory' | t }}:</span>

      <div class="product-form__info-content">
        {%- if selected_variant.available -%}
          {%- if selected_variant.inventory_management and selected_variant.inventory_policy == 'deny' and block.settings.low_inventory_threshold > 0 -%}
            {%- if selected_variant.inventory_quantity <= block.settings.low_inventory_threshold -%}
              <span class="product-form__inventory inventory inventory--low">{{ 'product.form.low_stock_with_quantity_count' | t: count: selected_variant.inventory_quantity }}</span>
            {%- else -%}
              <span class="product-form__inventory inventory inventory--high">{{ 'product.form.in_stock_with_quantity_count' | t: count: selected_variant.inventory_quantity }}</span>
            {%- endif -%}
          {%- else -%}
            {%- if selected_variant.inventory_policy == 'continue' and selected_variant.inventory_quantity <= 0 and selected_variant.requires_shipping -%}
              {%- if selected_variant.incoming -%}
                {%- capture next_incoming_date -%}{{ selected_variant.next_incoming_date | date: format: 'date' }}{%- endcapture -%}
                <span class="product-form__inventory inventory inventory--high">{{ 'product.form.incoming_stock' | t: next_incoming_date: next_incoming_date }}</span>
              {%- else -%}
                <span class="product-form__inventory inventory inventory--high">{{ 'product.form.oversell_stock' | t }}</span>
              {%- endif -%}
            {%- else -%}
              <span class="product-form__inventory inventory inventory--high">{{ 'product.form.in_stock' | t }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- else -%}
          <span class="product-form__inventory inventory">{{ 'product.form.sold_out' | t }}</span>
        {%- endif -%}

        {%- for tag in product.tags -%}
          {%- if tag contains '__stock:' -%}
            {%- assign stock_countdown_max = tag | split: '__stock:' | last | times: 1.0 -%}
            {%- assign stock_countdown_progress = selected_variant.inventory_quantity | divided_by: stock_countdown_max | times: 100.0 | at_least: 0 | at_most: 100 -%}

            <span class="inventory-bar {% if stock_countdown_progress == 0 %}inventory-bar--hidden{% endif %}" data-stock-countdown-max="{{ stock_countdown_max }}">
              <span class="inventory-bar__progress" style="width: 100%"></span>
            </span>

            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if product.template_suffix != 'contact' -%}
    {%- if block.settings.show_quantity_selector -%}
      <div class="product-form__info-item product-form__info-item--quantity">
        <label for="{{ section.id }}-{{ product.id }}-quantity" class="product-form__info-title text--strong">{{ 'product.form.quantity' | t }}:</label>

        <div class="product-form__info-content">
          {% comment %} <div class="quantity-selector quantity-selector--product">
            <button type="button" class="quantity-selector__button" data-action="decrease-picker-quantity" aria-label="{{ 'cart.items.decrease_quantity' | t }}" title="{{ 'cart.items.decrease_quantity' | t }}">{% render 'icon', icon: 'minus' %}</button>
            <input id="varQty" name="quantity" aria-label="{{ 'product.form.quantity' | t }}" class="quantity-selector__value" inputmode="numeric" value="1" size="3">
            <button type="button" class="quantity-selector__button" data-action="increase-picker-quantity" aria-label="{{ 'cart.items.increase_quantity' | t }}" title="{{ 'cart.items.increase_quantity' | t }}">{% render 'icon', icon: 'plus' %}</button>
          </div> {% endcomment %}
            <div class="quantity-selector quantity-selector--product">
            <button type="button" onclick="minusQty('')" class="quantity-selector__button" {% if isCustomRideQty == true %} disabled {% endif %}>{% render 'icon', icon: 'minus' %}</button>
            <input id="varQty" name="quantity" aria-label="{{ 'product.form.quantity' | t }}" class="quantity-selector__value varQtyAddToCart  q_number" {% if isCustomRideQty == true %} disabled data-label = "stockCustomRider" {% endif %} inputmode="numeric" value="0" size="3" min="0" max="99999" maxlength="5" oninput="this.value = this.value.replace(/[^0-9.]/g, '')">
            <button type="button" onclick="plusQty('')" class="quantity-selector__button" {% if isCustomRideQty == true %} disabled {% endif %} >{% render 'icon', icon: 'plus' %}</button>
          </div>
        </div>
      </div>
    {%- else -%}
      <input type="hidden" name="quantity" value="1">
    {%- endif -%}
  {%- endif -%}
</div>
{%- endunless -%}
 {% comment %} <hr> {% endcomment %}
  <div>
    <div id="variation">
    {%- assign VariationOptions = product.metafields.VariationOptions -%}
    </div>
     {% comment %} <input  id="varAddBtn" type="button" class="btn product-form__add-button button button--primary" value="Add Variation" data-vCount="0" onclick="addVariation(this)"  > {% endcomment %}
  </div>
{% comment %} <hr> {% endcomment %}

<div class="error add-to-cart"></div>

{%- render 'product-info-script', product: product, form: form, block: block -%}


