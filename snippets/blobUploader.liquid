<div class="modalpop modal_align_cart"
  id="formupload"
  style="display:none;">

  <!-- Modal content -->

  <div class="modal-contentnew_cart2 ">
    <span onclick="Form_upload_close()" id="close">&times;
    </span>
    <div class="modal-header1">Select a File to attach to your order by either uploading a new file or selecting a previously uploaded file.<br>
      <span style="color:red;font-size:12px">{{ shop.metafields.CustomDesign.Note.value }}<br>
     <span class="UploadDesignNotes" style="color: red; font-weight: bold; display:inline;"> {{ shop.metafields.UploadDesign.Notes.value }}</span></span>
    </div>
    <div class="modalbody">

      <div class="main">
        <div class="left1">
          <input
            class="selectbtn"
            type="button"
            value="Upload File"
            id="upfile1">
          <input
            type="file"
            id="file1"
            style="display:none;">
          <p id="err">* Please select file to proceed</p>
          <div>
            <p id="error">
              <b>Your upload failed.</b>
              Please be sure that the file you selected was a permitted file type, and try again. The following types are permitted: JPG, PNG, GIF, TIF, PSD, AI, PDF, EPS, SVG, DOC, XLS, CSV, TXT. If you cannot successfully upload your artwork, please email your artwork and web order number found on your order confirmation to
              <a href="mailto:info@hodgesbadge.com">info@hodgesbadge.com</a>
              after your order has been placed.</p>
            <span onclick="error_close()" id="errorcls">&times;</span>
          </div>
          <div id="previews"></div>
          <div></div>
        </div>
        <div class="right1">
          <p id="heading">Select a Previously Uploaded File</p>
          <div class="containerupload ">
            <img alt="" loading='lazy'  id="" src="">
          </div>
        </div>
      </div>

    </div>
    <div class="modalfooter">
       <p id="fileerr">Invalid file name. Please remove special characters.</p>
      <button
        id="but_upload_ok"
        class="button_upload_ok"
        onclick="blobUpload()">OK</button>

    </div>
 </div>
</div>

