{% unless customer %}
    <style>
    .jdgm-write-rev-link,
    .jdgm-form-wrapper {
      display: none !important;
    }
    
    .custom-review-login-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    
    .custom-review-login-btn {
      display: inline-block;
      padding: 12px 24px;
      background: #212f64;
      color: #fff;
      text-decoration: none;
      border-radius: 15px;
      font-weight: 600;
      text-align: center;
    }
    
    .custom-review-login-btn:hover {
      background: #1a2550;
    }
    .jm-action-buttons {
      display: none !important;
    }
    </style>
    
    <div class="custom-review-login-wrapper">
      <a
        class="custom-review-login-btn"
        href="{{ routes.account_login_url }}?return_url={{ product.url }}?review=true"
      >
        Sign In to Write Review
      </a>
    </div>  
{% endunless %}