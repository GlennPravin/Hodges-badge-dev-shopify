{%- comment -%}
  Render this only for one order passed in: {% render 'account-page-2-order-detail', order: order %}
  Do not loop customer.orders here. Loading every order's line items, product
  metafields, and JSON exceeds Shopify's Liquid memory limit.
{%- endcomment -%}
{% comment %} shghdghgh{{all_products[line_item.product.handle]}}  {% endcomment %}
{%- if order.name != blank -%}
  <script>
    var chargeCode = [];
    var reorder = [];
    var myAcc_productSubType = {};
    var lineItem1 = [];
    var myAcc_minLimits = {% if shop.metafields.MOAType %}{{ shop.metafields.MOAType | json }}{% else %}null{% endif %};
    var myAcc_commonOptions = {% if shop.metafields.CommonOptions %}{{ shop.metafields.CommonOptions | json }}{% else %}null{% endif %};
    var myAcc_VariationOptions = {% if shop.metafields.VariationOptions %}{{ shop.metafields.VariationOptions | json }}{% else %}null{% endif %};
    var myAcc_moaAmnts = {% if shop.metafields.helpText.MOAID %}{{ shop.metafields.helpText.MOAID | json }}{% else %}null{% endif %};
    var myAcc_flatCharges = {% if shop.metafields.FlatCharges %}{{ shop.metafields.FlatCharges | json }}{% else %}null{% endif %};
    var myAcc_setupCharges = {% if shop.metafields.setupcharge %}{{ shop.metafields.setupcharge | json }}{% else %}null{% endif %};
    var myAcc_flatChargeVariants = {% if shop.metafields.FlatChargeVariants %}{{ shop.metafields.FlatChargeVariants | json }}{% else %}null{% endif %};
    var myAcc_SetupChargeVariants = {% if shop.metafields.SetupChargeVariants %}{{ shop.metafields.SetupChargeVariants | json }}{% else %}null{% endif %};
    var myAcc_printonBackLines = {{ shop.metafields.printOnBackLines.optionIds.value | split: "," | json }};
    var myAcc_printonBack = {{ shop.metafields.printOnBack.optionIds.value | split: "," | json }};
    var subTypeIds = {{ shop.metafields.ProductSubType.subTypeIds | split: "," | json }};
    var excludeProductsSC = {{ shop.metafields.ExcludeProductsSC.ProductIds | split: "," | json }};
    window.accountPage2Reorders = {};
    window.accountPage2LineItems = {};
    {%- assign RemoveBuyButton = shop.metafields.helpText.RemoveAddtoCartButton.value -%}
    {%- assign promotionReorderHandle = "" -%}
    {%- if shop.metafields.helpText.PromotionCollectionName.value != blank -%}
      {%- assign promotionReorderHandle = shop.metafields.helpText.PromotionCollectionName.value | parse_json | first | default: "" -%}
    {%- endif -%}
    var PromotionReorder = "{{ promotionReorderHandle }}";
    {%- if promotionReorderHandle != "" and collections[promotionReorderHandle] != nil and collections[promotionReorderHandle].products.size > 0 -%}
      var PromotionProductsReorder = {{ collections[promotionReorderHandle].products | map: "id" | json }};
    {%- else -%}
      var PromotionProductsReorder = [];
    {%- endif -%}
  </script>
  {% render 'loader' %}

  <div class="account-page-2-order-details">
      {%- assign order_key = order.name | remove: "#" -%}
      {%- assign is_entirely_fulfilled = false -%}
      {%- assign has_one_fulfillment = false -%}
      {%- assign acCharges = false -%}

      {%- if order.fulfillment_status == "fulfilled" -%}
        {%- assign has_one_fulfillment = true -%}
        {%- assign is_entirely_fulfilled = true -%}
        {%- assign tracking_numbers = "" -%}
        {%- assign number_of_fulfillable_items = 0 -%}

        {%- for line_item in order.line_items -%}
          {%- assign number_of_fulfillable_items = number_of_fulfillable_items | plus: line_item.quantity -%}
        {%- endfor -%}

        {%- for line_item in order.line_items -%}
          {%- assign tracking_numbers = tracking_numbers | append: line_item.fulfillment.tracking_number | append: "," -%}
          {%- if line_item.fulfillment.item_count != number_of_fulfillable_items -%}
            {%- assign has_one_fulfillment = false -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <script>
        window.accountPage2Reorders[{{ order_key | json }}] = [];
        window.accountPage2LineItems[{{ order_key | json }}] = {{ order.line_items | json }};
        {%- for line_item in order.line_items -%}
          {%- if line_item.product.type != "HiddenCharges" and line_item.product != null and all_products[line_item.product.handle] != empty -%}
            chargeCode.push({ {{ line_item.product.id }}: {{ all_products[line_item.product.handle].metafields.chargecode | json }} });
            myAcc_productSubType[{{ line_item.properties["_hopsId"] | json }}] = {{ all_products[line_item.product.handle].metafields.ProductMeta.ProductAdditionalInfo.value.ExtraInfoAboutProduct.ProductSubType | append: "" | json }};
          {%- endif -%}
          {%- if line_item.product != null and all_products[line_item.product.handle] != empty -%}
            {%- unless RemoveBuyButton contains line_item.properties["_hopsId"] -%}
              window.accountPage2Reorders[{{ order_key | json }}].push({{ line_item | json }});
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </script>

      <div
        class="account-page-2-order-detail"
        data-order-path="{{ order.customer_url }}"
        data-order-key="{{ order_key }}"
        data-order-number="{{ order.order_number }}"
        hidden
      >
        <div class="order-summary card">
          <div class="card__header card__header--tight">
            <div class="card__navigation">
              <a href="{{ request.path }}" class="card__navigation-breadcrumb link account-page-2-back-to-orders">
                {% render "icon", icon: "arrow-left" %} {{ "customer.order.back_to_orders" | t }}
              </a>
              <p class="hidden-phone">{{ order.created_at | date: format: "month_day_year_time" }}</p>
            </div>
            <div class="row">
              <div class="column" style="width: 50%; padding: 10px;">
                <h1 class="card__title heading h1">{{ "customer.order.order_number" | t: order_number: order.name }}</h1>
              </div>
              <div class="column" style="width: 50%; padding: 10px;">
                <button onclick="myAccountAddtoCart(reorder)" type="button" class="reorder__button" style="width:50%;float:right;font-weight: bold; border:none; border-radius: 2px; background-color: #ae1a1a; color:white; padding:10px;"> ReOrder </button>
              </div>
            </div>
            <p class="hidden-tablet-and-up">{{ order.created_at | date: format: "month_day_year_time" }}</p>

            {%- if order.cancelled -%}
              {%- capture cancellation_date -%}{{ order.cancelled_at | date: format: "month_day_year_time" }}{%- endcapture -%}
              <div class="order-summary__alert">
                <p class="alert alert--large alert--error">{{ "customer.order.cancelled_at" | t: date: cancellation_date, reason: order.cancel_reason_label }}</p>
              </div>
            {%- endif -%}

            {%- if order.metafields.TrakingNumbers.TrakingNumberURL != "" -%}
              {%- for trackNum in order.metafields.TrakingNumbers.TrakingNumberDetails.TrakingNumbers -%}
                <p class="alert alert--large alert--success">YOUR TRACKING NUMBER IS {{ trackNum }}, <a href="{{ order.metafields.TrakingNumbers.TrakingNumberURL | append: trackNum }}" class="link text--strong">click here to track the package</a></p>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <div class="table-responsive{-sm|-md|-lg|-xl} table-responsive-sm table-responsive-md table-responsive-lg table-responsive-xl re_respon">
            <table class="table table_reorder_respon">
              <thead>
                <tr class="head_tr_row">
                  <th class="pro_respon">Product</th>
                  <th class="table__cell--center">Quantity</th>
                  <th class="table__cell--right">Price</th>
                  <th class="table__cell--right tabhead_respon">Total</th>
                </tr>
              </thead>

              {%- assign minOrderAmount = 0 -%}
              {%- assign setupAmount = 0 -%}
              {%- assign hiddenCharges = 0 -%}
              {%- assign flatCharges = 0 -%}
              {%- assign flatChargeItems = "" -%}
              {%- assign ppCharges = 0 -%}

              <tbody>
                {%- for line_item in order.line_items -%}
                  {%- if line_item.title contains "Additional Charges" -%}
                    {%- assign acCharges = true -%}
                  {%- endif -%}
                  {%- if line_item.product.type == "HiddenCharges" -%}
                    {%- if line_item.title contains "Premium Processing Charges" -%}
                      {%- assign ppCharges = line_item.final_price | times: line_item.quantity -%}
                      {%- assign hiddenCharges = hiddenCharges | plus: ppCharges -%}
                    {%- endif -%}
                    {%- if line_item.title contains "Minimum Order Amount" -%}
                      {%- assign minOrderAmount = line_item.final_price -%}
                      {%- assign hiddenCharges = hiddenCharges | plus: minOrderAmount -%}
                    {%- endif -%}
                    {%- if line_item.title contains "Setup Charges" -%}
                      {%- assign tempSetupAmount = line_item.final_price | times: line_item.quantity -%}
                      {%- assign setupAmount = setupAmount | plus: tempSetupAmount -%}
                      {%- assign hiddenCharges = hiddenCharges | plus: tempSetupAmount -%}
                    {%- endif -%}
                    {%- if line_item.title contains "Flat Charges" -%}
                      {%- assign LineitemAmnt = line_item.final_price | times: line_item.quantity -%}
                      {%- if flatChargeItems == "" -%}
                        {%- assign flatChargeItems = flatChargeItems | append: line_item.properties["ChargeType"] | append: ":" | append: LineitemAmnt -%}
                      {%- else -%}
                        {%- assign flatItems = flatChargeItems | split: "," -%}
                        {%- for item in flatItems -%}
                          {%- assign itemCheck = line_item.properties["ChargeType"] -%}
                          {%- assign itemVal = item | split: ":" -%}
                          {%- if itemCheck == itemVal[0] -%}
                            {%- assign itemValCharges = itemVal[1] | plus: LineitemAmnt -%}
                            {%- assign replaceItem = itemVal[0] | append: ":" | append: itemValCharges -%}
                            {%- assign flatChargeItems = flatChargeItems | replace: item, replaceItem -%}
                          {%- else -%}
                            {%- assign flatChargeItems = flatChargeItems | append: "," | append: line_item.properties["ChargeType"] | append: ":" | append: LineitemAmnt -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- assign flatCharges = flatCharges | plus: LineitemAmnt -%}
                      {%- assign hiddenCharges = hiddenCharges | plus: LineitemAmnt -%}
                    {%- endif -%}
                    {%- continue -%}
                  {%- endif -%}

                  <tr class="line-item tr_respon_data">
                    <td class="line-item__product-info">
                      <div class="line-item__product-info-wrapper repon_tab">
                        <div
                          class="line-item__image-wrapper"
                          data-account-line-image
                          data-line-index="{{ forloop.index0 }}"
                          data-product-handle="{{ line_item.product.handle | escape }}"
                          data-product-url="{{ line_item.url | escape }}"
                          data-product-id="{{ line_item.product_id }}"
                          data-variant-id="{{ line_item.variant_id }}"
                          data-hops-id="{{ line_item.properties['_hopsId'] | escape }}"
                          data-sku="{{ line_item.sku | escape }}"
                          data-title="{{ line_item.title | escape }}"
                        >
                          {%- assign line_product = line_item.product -%}
                          {%- assign selected_media = line_item.variant.featured_media | default: line_product.featured_media -%}
                          {%- if selected_media == blank -%}
                            {%- assign selected_media = line_product.featured_image -%}
                          {%- endif -%}
                          {%- if selected_media == blank and line_product.media.size > 0 -%}
                            {%- assign selected_media = line_product.media.first -%}
                          {%- endif -%}
                          {%- if selected_media == blank -%}
                            {%- assign selected_media = line_item.image -%}
                          {%- endif -%}
                          {%- assign alternate_images = line_product.metafields.ProductMeta.ProductAdditionalInfo.value.ExtraInfoAboutProduct.shopifyAlternateImages -%}
                          {%- if alternate_images.size > 0 and line_product.media.size > 0 -%}
                            {%- assign alternate_found = false -%}
                            {%- for hops_media in alternate_images -%}
                              {%- if alternate_found -%}{%- break -%}{%- endif -%}
                              {%- assign hops_market = hops_media.marketId | append: "" | strip -%}
                              {%- if hops_market != blank -%}{%- continue -%}{%- endif -%}
                              {%- assign hops_image_id = hops_media.imageSrc | append: "" -%}
                              {%- for media in line_product.media -%}
                                {%- assign media_id = media.id | append: "" -%}
                                {%- assign media_image_id = media.preview_image.id | append: "" -%}
                                {%- if media_id == hops_image_id or media_image_id == hops_image_id -%}
                                  {%- assign selected_media = media -%}
                                  {%- assign alternate_found = true -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endfor -%}
                          {%- endif -%}
                          {%- assign line_image_src = "" -%}
                          {%- if selected_media != blank -%}
                            {%- assign line_image_src = selected_media | image_url: width: 240 -%}
                          {%- endif -%}
                          {%- if line_image_src == blank and selected_media.preview_image -%}
                            {%- assign line_image_src = selected_media.preview_image | image_url: width: 240 -%}
                          {%- endif -%}
                          {%- if line_image_src == blank and selected_media.preview_image.src != blank -%}
                            {%- assign line_image_src = selected_media.preview_image.src -%}
                          {%- endif -%}
                          {%- if line_image_src == blank and selected_media.src != blank -%}
                            {%- assign line_image_src = selected_media.src -%}
                          {%- endif -%}
                          {%- if line_image_src == blank and line_item.image -%}
                            {%- assign line_image_src = line_item.image | image_url: width: 240 -%}
                          {%- endif -%}
                          {%- if line_image_src == blank and line_item.image.src != blank -%}
                            {%- assign line_image_src = line_item.image.src -%}
                          {%- endif -%}
                          {%- if line_image_src == blank and line_product.images.size > 0 -%}
                            {%- assign line_image_src = line_product.images.first | image_url: width: 240 -%}
                          {%- endif -%}
                          {%- if line_image_src == blank and selected_media != blank -%}
                            {%- assign line_image_src = selected_media | img_url: "240x" -%}
                          {%- endif -%}
                          {%- assign canvas_image = line_item.properties["_canvasImage"] -%}
                          {%- if line_image_src == blank and canvas_image contains "//" -%}
                            {%- assign line_image_src = canvas_image -%}
                          {%- endif -%}
                          {%- if line_image_src contains "//" -%}
                            {%- unless line_image_src contains "http" -%}
                              {%- assign line_image_src = line_image_src | prepend: "https:" -%}
                            {%- endunless -%}
                          {%- endif -%}
                          {%- assign line_image_src = line_image_src | strip -%}
                          {%- if line_image_src != blank -%}
                            <img class="account-order-line-image" src="{{ line_image_src | escape }}" alt="{{ line_item.title | escape }}" width="90" height="90" style="width:90px;height:90px;max-width:90px;object-fit:contain;display:block;">
                          {%- endif -%}
                        </div>
                        {% comment %} warner{{line_item |  json}}  {% endcomment %}
                        <div class="line-item__meta">
                          <a href="{{ line_item.url }}" class="line-item__title link text--strong ang_line">{{ line_item.product.title }}</a>
                          <span class="line-item__price">{{ line_item.properties["_hopsId"] }}</span>
                          {%- if line_item.selling_plan_allocation -%}
                            <p class="line-item__plan-allocation">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          {%- unless line_item.properties == blank -%}
                            <ul class="line-item__property-list" role="list">
                              {%- for property in line_item.properties -%}
                                {%- assign first_character_in_key = property.first | truncate: 1, "" -%}
                                {%- if property.first == "Base Additional Charge" -%}
                                  {%- continue -%}
                                {%- endif -%}
                                {%- if property.last == blank or first_character_in_key == "_" and property.first != "_CustomDesign" and property.first != "_CustomDesignCenter" -%}
                                  {%- continue -%}
                                {%- endif -%}
                                {%- if property.first contains "CustomDesign" or property.first contains "CustomDesignCenter" -%}
                                  {%- assign url_parts = property.last | split: "." -%}
                                  {%- assign extension = url_parts.last | prepend: 0 -%}
                                  {%- assign key = property.first -%}
                                  {%- if shop.metafields.PreviewIcon[extension] -%}
                                    <li class="line-item__property">{{ key | split: "_" }}:<a href="{{ property.last }}"><img loading="lazy" src="{{ shop.metafields.PreviewIcon[extension].value }}" alt="{{ property.last }}" width="75" height="75"></a></li>
                                  {%- else -%}
                                    <li class="line-item__property">{{ key | split: "_" }}:<a href="{{ property.last }}"><img loading="lazy" src="{{ property.last }}" alt="{{ property.last }}" width="75" height="75"></a></li>
                                  {%- endif -%}
                                {%- else -%}
                                  {%- if property.first contains ".~" -%}
                                    {%- assign prop = property.first | split: ".~" -%}
                                    <li class="line-item__property">{{ prop[1] }}: {{ property.last }}</li>
                                  {%- else -%}
                                    <li class="line-item__property">{{ property.first }}: {{ property.last }}</li>
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endfor -%}
                            </ul>
                          {%- endunless -%}

                          {%- if line_item.unit_price_measurement -%}
                            <div class="line-item__price-info">
                              <div class="unit-price-measurement">
                                <span class="unit-price-measurement__price">{{ line_item.unit_price | money }}</span>
                                <span class="unit-price-measurement__separator">/ </span>
                                {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                                  <span class="unit-price-measurement__reference-value">{{ line_item.unit_price_measurement.reference_value }}</span>
                                {%- endif -%}
                                <span class="unit-price-measurement__reference-unit">{{ line_item.unit_price_measurement.reference_unit }}</span>
                              </div>
                            </div>
                          {%- endif -%}

                          {%- if line_item.line_level_discount_allocations != blank -%}
                            <ul class="line-item__discount-list" role="list">
                              {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                                <li class="line-item__discount">
                                  {%- render "icon", icon: "sale" -%}{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      </div>

                      {%- assign variations = "" -%}
                      {%- for property in line_item.properties -%}
                        {%- if property.first == "Variation" -%}
                          {%- assign variations = "isVariant" -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if variations == "isVariant" -%}
                        
                      {%- else -%}
                        {%- if all_products[line_item.product.handle] == empty -%}
                          {% comment %} shghdghgh{{line_item |  json}}  {% endcomment %}
    
                          <p style="color:red">{{ shop.metafields.helpText.draftProductMsg.value }}</p>
                          <script>
                            console.log("[order unavailable] Order {{ order.name | escape }}", {
                              lineTitle: {{ line_item.title | json }},
                              hopsId: {{ line_item.properties["_hopsId"] | json }},
                              sku: {{ line_item.sku | json }},
                              productId: {{ line_item.product_id | json }},
                              variantId: {{ line_item.variant_id | json }},
                              productHandle: {{ line_item.product.handle | json }},
                              productOnOrder: {% if line_item.product == blank %}false{% else %}true{% endif %},
                              allProductsEmpty: true,
                              reason: {% if line_item.product == blank %}"line_item.product is nil. The Shopify product saved on this order was deleted, so all_products[handle] is empty."{% else %}"Product is still linked on the order, but all_products[handle] is empty. It is draft, archived, or not published to the Online Store."{% endif %}
                            });
                          </script>
                        {%- elsif RemoveBuyButton contains line_item.properties['_hopsId'] -%}
                          <p>{{ shop.metafields.helpText.ContactForPurchase.value }}</p>
                        {%- else -%}
                          <button class="btnn_respon" onclick="myAccountAddtoCart(lineItem1,{{ forloop.index }});" type="button" style="width:40%;font-weight: bold; border:none; border-radius: 2px; background-color: var(--heading-color); color:white; padding:10px;"> Add to cart </button>
                        {%- endif -%}
                      {%- endif -%}
                    </td>
                    <td class="line-item__quantity table__cell--center break">{{ line_item.quantity }}</td>
                    {%- if line_item.final_line_price == 0 -%}
                      {{- "cart.general.free" | t -}}
                    {%- elsif acCharges -%}
                      {%- assign _baseAc = line_item.properties["_baseAc"] | times: 100 -%}
                      <td class="line-item__line-price table__cell--right break1">{{ _baseAc | plus: line_item.final_price | money }}</td>
                    {%- else -%}
                      <td class="line-item__line-price table__cell--right break1">{{ line_item.final_price | money }}</td>
                    {%- endif -%}
                    {%- if line_item.final_line_price == 0 -%}
                      {{- "cart.general.free" | t -}}
                    {%- elsif acCharges -%}
                      {%- assign _totalAc = line_item.properties["_totalAc"] | times: 100 -%}
                      <td class="line-item__line-price table__cell--right break2 tab_total_respon"><div>{{ _totalAc | plus: line_item.final_line_price | money }}</div></td>
                    {%- else -%}
                      <td class="line-item__line-price table__cell--right break2 tab_total_respon"><div>{{ line_item.final_line_price | money }}</div></td>
                    {%- endif -%}
                  </tr>

                  {%- unless is_entirely_fulfilled and has_one_fulfillment -%}
                    {%- if line_item.fulfillment -%}
                      <tr class="fulfillment-item">
                        <td colspan="3">
                          {%- if line_item.fulfillment.tracking_url != blank and line_item.fulfillment.tracking_number != blank -%}
                            <p class="alert alert--large alert--success">{{ "customer.order.line_fulfillment_with_url_and_number_html" | t: tracking_url: line_item.fulfillment.tracking_url, tracking_number: line_item.fulfillment.tracking_number }}</p>
                          {%- else -%}
                            <p class="alert alert--large alert--success">{{ "customer.order.line_fulfillment_html" | t }}</p>
                          {%- endif -%}
                        </td>
                      </tr>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          <div class="order-foot">
            <div class="order-foot__inner">
              {%- if hiddenCharges > 0 -%}
                <div class="order-foot__item">
                  {%- assign merchandiseTotal = order.line_items_subtotal_price | minus: hiddenCharges -%}
                  <span class="order-foot__item-category">Merchandise Total</span>
                  <span class="order-foot__item-value">{{ merchandiseTotal | money }}</span>
                </div>
                {%- if setupAmount > 0 -%}
                  <div class="order-foot__item">
                    <span class="order-foot__item-category">Setup Charges</span>
                    <span class="order-foot__item-value">{{ setupAmount | money }}</span>
                  </div>
                {%- endif -%}
                {%- if flatCharges > 0 -%}
                  {%- assign flatItems = flatChargeItems | split: "," -%}
                  {%- for item in flatItems -%}
                    {%- assign itemVal = item | split: ":" -%}
                    <div class="order-foot__item">
                      <span class="order-foot__item-category">{{ itemVal[0] }}</span>
                      <span class="order-foot__item-value">{{ itemVal[1] | money }}</span>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
                {%- if minOrderAmount > 0 -%}
                  <div class="order-foot__item">
                    <span class="order-foot__item-category">Miniumum Order Charges</span>
                    <span class="order-foot__item-value">{{ minOrderAmount | money }}</span>
                  </div>
                {%- endif -%}
                {%- if ppCharges > 0 -%}
                  <div class="order-foot__item">
                    <span class="order-foot__item-category">Premium Processing Charges</span>
                    <span class="order-foot__item-value">{{ ppCharges | money }}</span>
                  </div>
                {%- endif -%}
              {%- endif -%}
              <hr>

              <div class="order-foot__item">
                <span class="order-foot__item-category">{{ "customer.order.subtotal" | t }}</span>
                <span class="order-foot__item-value">{{ order.line_items_subtotal_price | money }}</span>
              </div>

              {%- for discount_application in order.cart_level_discount_applications -%}
                <div class="order-foot__item order-foot__item--highlight">
                  <span class="order-foot__item-category">{{ "customer.order.discount" | t }} ({{ discount_application.title }})</span>
                  <span class="order-foot__item-value">-{{ discount_application.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}

              {%- for shipping_method in order.shipping_methods -%}
                <div class="order-foot__item">
                  <span class="order-foot__item-category">{{ "customer.order.shipping" | t }} ({{ shipping_method.title }})</span>
                  <span class="order-foot__item-value">{{ shipping_method.price | money }}</span>
                </div>
              {%- endfor -%}

              {%- for tax_line in order.tax_lines -%}
                <div class="order-foot__item">
                  {%- if cart.taxes_included -%}
                    <span class="order-foot__item-category">{{ "customer.order.tax_included" | t }} ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</span>
                  {%- else -%}
                    <span class="order-foot__item-category">{{ "customer.order.tax_excluded" | t }} ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</span>
                  {%- endif -%}
                  <span class="order-foot__item-value">{{ tax_line.price | money }}</span>
                </div>
              {%- endfor -%}

              {%- if order.total_refunded_amount > 0 -%}
                <div class="order-foot__item">
                  <span class="order-foot__item-category">{{ "customer.order.refunded_amount" | t }}</span>
                  <span class="order-foot__item-value">{{ order.total_refunded_amount | money }}</span>
                </div>
              {%- endif -%}

              <div class="order-foot__item order-foot__item--strong">
                <span class="order-foot__item-category">{{ "customer.order.total" | t }}</span>
                <span class="order-foot__item-value">{{ order.total_net_amount | money }}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid">
          <div class="grid__cell 1/2--tablet-and-up">
            <div class="card">
              <div class="card__section">
                <p class="heading h6">{{ "customer.order.billing_address" | t }}</p>
                {%- if order.billing_address -%}
                  {{- order.billing_address | format_address -}}
                {%- else -%}
                  <p>{{ "customer.order.no_billing_address" | t }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
          <div class="grid__cell 1/2--tablet-and-up">
            <div class="card">
              <div class="card__section">
                <p class="heading h6">{{ "customer.order.shipping_address" | t }}</p>
                {%- if order.shipping_address -%}
                  {{- order.shipping_address | format_address -}}
                {%- else -%}
                  <p>{{ "customer.order.no_shipping_address" | t }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
      <script>
        (function () {
          function absUrl(src) {
            if (!src) return "";
            src = String(src);
            if (src.indexOf("//") === 0) return "https:" + src;
            return src;
          }
          function setImage(slot, src) {
            src = absUrl(src);
            if (!src || slot.querySelector("img[src]")) return;
            var img = document.createElement("img");
            img.className = "account-order-line-image";
            img.alt = slot.getAttribute("data-title") || "";
            img.width = 90;
            img.height = 90;
            img.style.cssText = "width:90px;height:90px;max-width:90px;object-fit:contain;display:block;";
            img.src = src;
            slot.appendChild(img);
          }
          function propValue(props, key) {
            if (!props) return "";
            if (!Array.isArray(props)) return props[key] || "";
            for (var i = 0; i < props.length; i++) {
              if (props[i] && props[i][0] === key) return props[i][1] || "";
            }
            return "";
          }
          function srcFromItem(item) {
            if (!item) return "";
            var canvas = propValue(item.properties, "_canvasImage");
            if (canvas && String(canvas).indexOf("//") !== -1) return canvas;
            if (typeof item.image === "string" && item.image) return item.image;
            if (item.image && (item.image.src || item.image.url)) return item.image.src || item.image.url;
            if (typeof item.featured_image === "string" && item.featured_image) return item.featured_image;
            if (item.featured_image && (item.featured_image.url || item.featured_image.src)) return item.featured_image.url || item.featured_image.src;
            var product = item.product || null;
            if (!product) return "";
            if (typeof product.featured_image === "string" && product.featured_image) return product.featured_image;
            if (product.featured_image && (product.featured_image.src || product.featured_image.url)) return product.featured_image.src || product.featured_image.url;
            if (product.images && product.images.length) {
              var first = product.images[0];
              if (typeof first === "string") return first;
              if (first && (first.src || first.url)) return first.src || first.url;
            }
            return "";
          }
          function handleFrom(slot, item) {
            var handle = slot.getAttribute("data-product-handle") || "";
            if (handle) return handle;
            var url = slot.getAttribute("data-product-url") || "";
            if (!url && item) url = item.url || (item.product && item.product.url) || "";
            var match = String(url).match(/\/products\/([^/?#]+)/);
            if (match) return decodeURIComponent(match[1]);
            if (item && item.handle) return item.handle;
            if (item && item.product && item.product.handle) return item.product.handle;
            return "";
          }
          function imageFromProduct(product, variantId) {
            if (!product) return "";
            var variants = product.variants || [];
            for (var i = 0; i < variants.length; i++) {
              if (variantId && String(variants[i].id) === String(variantId) && variants[i].featured_image && variants[i].featured_image.src) {
                return variants[i].featured_image.src;
              }
            }
            if (product.featured_image) return product.featured_image;
            if (product.images && product.images.length) return product.images[0];
            return "";
          }
          function skuMatches(product, hopsId) {
            var variants = product.variants || [];
            for (var i = 0; i < variants.length; i++) {
              if (String(variants[i].sku) === String(hopsId)) return true;
            }
            return false;
          }
          var root = document.querySelector(".account-page-2-order-detail");
          if (!root) return;
          var key = root.getAttribute("data-order-key");
          var items = (window.accountPage2LineItems && window.accountPage2LineItems[key]) || [];
          var hopsWait = {};

          function applyHops(hopsId, src) {
            (hopsWait[hopsId] || []).forEach(function (slot) { setImage(slot, src); });
          }
          function confirmHandle(handle, hopsId) {
            return fetch("/products/" + encodeURIComponent(handle) + ".js", { credentials: "same-origin" })
              .then(function (response) { return response.ok ? response.json() : null; })
              .then(function (product) {
                if (!product) return "";
                if (skuMatches(product, hopsId) || String(product.handle) === String(hopsId)) return imageFromProduct(product, "");
                return fetch("/products/" + encodeURIComponent(handle), { credentials: "same-origin" })
                  .then(function (response) { return response.ok ? response.text() : ""; })
                  .then(function (html) {
                    if (html.indexOf('hopsProdId = "' + hopsId + '"') === -1 && html.indexOf('data-id="' + hopsId + '"') === -1) return "";
                    return imageFromProduct(product, "") || ((html.match(/property="og:image" content="([^"]+)"/) || [])[1] || "");
                  });
              });
          }
          function lookupByHops(slot, hopsId) {
            if (hopsWait[hopsId]) {
              hopsWait[hopsId].push(slot);
              return;
            }
            hopsWait[hopsId] = [slot];
            var title = slot.getAttribute("data-title") || "";
            var queries = [];
            if (title && title !== hopsId) queries.push(title);
            queries.push(hopsId);
            confirmHandle(hopsId, hopsId).then(function (src) {
              if (src) {
                applyHops(hopsId, src);
                return;
              }
              var chain = Promise.resolve("");
              queries.forEach(function (query) {
                chain = chain.then(function (found) {
                  if (found) return found;
                  var searchUrl = "/search/suggest.json?q=" + encodeURIComponent(query) + "&resources[type]=product&resources[limit]=6&resources[options][fields]=title,product_type,variants.sku,tag";
                  return fetch(searchUrl, { credentials: "same-origin" })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (data) {
                      var products = (data && data.resources && data.resources.results && data.resources.results.products) || [];
                      var handles = [];
                      products.forEach(function (product) {
                        if (product.handle && handles.indexOf(product.handle) === -1) handles.push(product.handle);
                      });
                      var inner = Promise.resolve("");
                      handles.forEach(function (handle) {
                        inner = inner.then(function (match) {
                          if (match) return match;
                          return confirmHandle(handle, hopsId);
                        });
                      });
                      return inner;
                    });
                });
              });
              return chain.then(function (found) { if (found) applyHops(hopsId, found); });
            }).catch(function () {});
          }

          root.querySelectorAll("[data-account-line-image]").forEach(function (slot) {
            if (slot.querySelector("img[src]")) return;
            var item = items[slot.getAttribute("data-line-index")] || null;
            var src = srcFromItem(item);
            if (src) {
              setImage(slot, src);
              return;
            }
            var handle = handleFrom(slot, item);
            var hopsId = slot.getAttribute("data-hops-id") || "";
            var variantId = slot.getAttribute("data-variant-id") || (item && item.variant_id) || "";
            if (handle) {
              fetch("/products/" + encodeURIComponent(handle) + ".js", { credentials: "same-origin" })
                .then(function (response) { return response.ok ? response.json() : null; })
                .then(function (product) {
                  var found = imageFromProduct(product, variantId);
                  if (found) setImage(slot, found);
                  else if (hopsId) lookupByHops(slot, hopsId);
                })
                .catch(function () { if (hopsId) lookupByHops(slot, hopsId); });
              return;
            }
            if (hopsId) lookupByHops(slot, hopsId);
          });
        })();
      </script>
  </div>
  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var requested = (params.get("order_name") || "").replace(/[#\s]/g, "");
      var detail = document.querySelector(".account-page-2-order-detail");
      var key = detail ? (detail.getAttribute("data-order-key") || "").replace(/[#\s]/g, "") : "";
      var number = detail ? (detail.getAttribute("data-order-number") || "").replace(/[#\s]/g, "") : "";
      var loaderEl = document.getElementById("loaderbg");
      if (detail && requested && (key === requested || number === requested)) {
        detail.classList.add("is-active");
        detail.removeAttribute("hidden");
        document.documentElement.removeAttribute("data-account-order-loading");
        if (loaderEl) loaderEl.style.display = "none";
        return;
      }
      if (requested) document.documentElement.setAttribute("data-account-order-loading", requested);
      if (loaderEl) loaderEl.style.display = "block";
    })();
  </script>
{%- endif -%}
