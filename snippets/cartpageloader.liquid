  #text{
    font-size: 16px;
  }
}
 </style>
{% if canvasEnabled %}
<div id="cart-page" class="scene">
	<img src="https://cdn.shopify.com/s/files/1/0691/7082/3461/files/Loader_image-1.png?v=1721995333" id="mustard" class="product" alt="Mustard">
	<img src="https://cdn.shopify.com/s/files/1/0691/7082/3461/files/Loader_image-2.png?v=1721995346" id="meat" class="product" alt="Meat">
	<img src="https://cdn.shopify.com/s/files/1/0691/7082/3461/files/Loader_image-3.png?v=1721995425" id="soda" class="product" alt="Soda">
	{% comment %} <img src="https://hodges-badge-sandbox-dev.myshopify.com/cdn/shop/files/x-large_9b8e9756-adbd-4e63-9eb7-898a14d95669_180x.jpg?v=1688634440" id="stream" class="product" alt="stream"> {% endcomment %}

  <div class="cart-container">
  <svg 
	 viewBox="0 0 512 512" id="cart-new">
<circle cx="376.8" cy="440" r="55"/>
<circle cx="192" cy="440" r="55"/>
