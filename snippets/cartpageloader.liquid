{% assign canvasEnabled = false %}
{%- if product.metafields.CanvasLayerOptions.IsCanvasConfigEnabled == true -%}
{% assign canvasEnabled = product.metafields.CanvasLayerOptions.IsCanvasConfigEnabled %}
{%- endif -%}

<style>
 .scene {
	display: none;
  height: 100%;
  position: fixed;
  top: 0px;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
}

.cart-container {
  width: 900px;
  margin: 5em auto;
  margin-top: 7em;
}

#cart-new {
  /* width: 150px;
  display:inline-block; */
    width: 150px;
    display: inline-block;
    margin-top: 106px;
}

.product {
  /* width: 60px;
  position: absolute;
  left: 50%; */
  margin-top: 189px;
    width: 60px;
    position: absolute;
    left: 50%;
  opacity: 0;
  transform: scale(2);
}
 #text{
	text-align: center;
	font-size: 25px;
	color: #ff0000;
	font-weight: 500;
 }
