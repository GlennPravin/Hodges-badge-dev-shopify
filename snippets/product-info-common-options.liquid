                    data-html="true" 
                  {% endif %} 
                  value="(Or) Choose" >
                {%- endif -%}
              </div>

              <div class="pop-chosen-value" 
                data-option-id="{{common_option['optionId']}}" >
                <a  onclick="clearChoosenValue(this)" class="close" >&times;</a>
                <input id="{{common_option['optionId']}}_id" 
                  type="hidden" 
                  value="" 
                  {% comment %} class="meta-reference-master"  {% endcomment %}
                  data-key="{{ common_option['optionId'] }}" 
                  data-charge="{{ common_option['additionalCharge'] }}" 
                  data-chargeCode="" 
                  data-charge-type="{{ common_option["chargeType"]}}" 
                  {% if common_option['isRequired'] %} required {% endif %} />
                <img loading='lazy' class="img_border_i" name="{{common_option['optionId']}}" 
                  loading="lazy" 
                  id="{{common_option['optionId']}}" 
                  src="" />
                <div name="{{common_option['optionId']}}_text" 
                  id="{{common_option['optionId']}}_txt" ></div>
              </div>
              {%- else -%}
            
              <select {% if common_option['stockCustomRider'] %} class="{{ common_option['stockCustomRider'] }}" {% endif %}
            data-label="{{ common_option['label'] }}" name="{{ common_option['optionId'] }}"
            id="{{ common_option['optionId'] }}" {% if common_option['isRequired'] %} required {% endif %} {% if
            common_option["optionMessage"] %} data-toggle="tooltip" data-placement="top" title="{{ common_option["
            optionMessage"] }}" data-html="true" {% endif %}>
                <option  value=""  selected>- Select an Option - </option>
                {%- for block_swatch in common_option.values -%}
                  {%- capture block_swatch_id -%}{{block_swatch.id}}-{{forloop.index}}{%- endcapture -%}
                  <option value="{{ block_swatch.id }}" >{{ block_swatch.name | escape }}</option>
                {%- endfor -%}
              </select>
              {%- endif -%}
            </div>
            {%- endif -%}
          {%- endif -%}
        <div class="error {{common_option['optionId']}}"></div>
      </li>
    {%- endfor -%}
  </ul>
</div>

<script>
 $($('.or_clause')[0]).closest('li').addClass('center_class')
</script>