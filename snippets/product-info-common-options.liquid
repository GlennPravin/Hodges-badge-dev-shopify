{% comment %} {%- assign CommonOptions = product.metafields.CommonOptions -%} {% endcomment %}
{%- assign family = product.metafields.ProductMeta.ProductAdditionalInfo.value.ExtraInfoAboutProduct.optionFamilyId | strip -%}
{%- assign strName = product.metafields.PriceInfo.QuantityRangePrices.value.OptionId -%}
{%- assign printonBack = shop.metafields.printOnBack.optionIds.value | split: "," -%}
{%- assign CommonOptions = shop.metafields.optionFamily[family].value.commonOptions -%}
{%- assign optionsLimit =  shop.metafields.optionFamily[family].value.optionsLimit -%}
<script>
  var popupOptions = {{CommonOptions | json}};
  var popup_Options = {{shop.metafields.CommonOptions | json}};
</script>
<div class="product-form__option info-option">
  <ul id="CommonOptions" >
    {%- for option in CommonOptions -%}
      {%- if option == strName -%}
        {%- continue-%}
        {%- endif-%}
      {%- assign common_option = shop.metafields.CommonOptions[option].value -%}
      {%- assign content_length = common_option.values.size -%}
      {%- if common_option.values.size >0 and common_option['isUploadEnabled']==false -%}
        
        {%- if common_option['isViewOption'] -%}
          {%- assign common_type = 'dependent-popup' -%}
        {%- else -%}
          {%- assign common_type = 'dependent-select' -%}
        {%- endif-%}
      {%- else -%}
        {%- if content_length <= 0 -%}
          {%- if common_option.isUploadEnabled  -%}
            {%- assign common_type = 'input-file' -%}
              {%- else -%}
            {%- assign common_type = 'input-text' -%}
          {%- endif -%}
        {%- elsif content_length > 0 -%}
          {%- if common_option['isViewOption'] -%}
            {%- assign common_type = 'popup' -%}
          {%- else -%}
            {%- assign common_type = 'select' -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
     
      {%- assign content_length = common_option.values.size -%}
