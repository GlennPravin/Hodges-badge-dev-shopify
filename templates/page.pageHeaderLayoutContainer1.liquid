  <script>
  var stockDesigns = {{ shop.metafields.ColorStkImgMR | json}}
   var catValues = {{ shop.metafields.StockDesignCategory | json}};
  console.log(catValues,'catValues');
  window.onload = popUpDe('CENTER_GOLDRIM','01CO','Color');
      function popUpDe(id, pId,stkColor) {
        $('div#buttons').empty();
        const popSearch = ({oId}) => ` 
            <div class="catdiv">  
                <input id="popSearch${oId}" class="popSearch" onkeyup="popupSearchFilter(this,'${oId}_popup','${oId}' )" type="text" name="search" placeholder="Search..">
                <ul class="catul">
                    <li class="catli selected caltliAll" onclick="filterCategory('All',this)"><a href="#" >All</a></li>
                </ul>
            </div>`;
        $('div#buttons').append([{oId:id}].map(popSearch).join(''));  
    
        var catValues = {{ shop.metafields.StockDesignCategory | json}};
        var cat = catValues[stkColor.toLowerCase()];
    
        if(cat){
            var catItems = cat.split(",");
            for (cate in catItems) {
                var item = catItems[cate];
                const popcate = ({li,oId}) => ` <li class="catli"  onclick="filterCategory('${li}',this,'${oId}')"><a href="#" >${li}</a></li>`;
                $('.catul').append([{li:item, oId:id}].map(popcate).join(''));  
            }
        }
            
       
        var  dependValues={};
         
    
            dependValues = {{ shop.metafields.ColorStkImgMR | json}};
           // console.log('dependValues',dependValues);
  
    
        for (option in dependValues) {
          
            if(option.includes(stkColor.toLowerCase())){
                for ( var pop_value in dependValues[option].values) {
                    var popvalues = dependValues[option].values[pop_value];
                console.log('test');
                    var valId = popvalues.id;
                    var valName = popvalues.name;
                    var valImage = popvalues.image;
                    var valAdd = popvalues.additionalCharge;
                    var valChargeType = popvalues.chargeType;
    
                    var designCategory = popvalues.DesignCategory1;
                    var designKeywords = popvalues.Keywords;
    
                    let str_val = valAdd;
    console.log('valName',valName);
                  //  var value_name_add = valName + ' - Add: $'+valAdd;
  
           
                        var value_name_add = valName;
  
                    const popupOption = ({oId,vImage,vName,vName1,vId, parId,dc,dk, str_val,valAdd}) => `                    
                        <div class="view-option-block" onmouseover="dis_image_enlarge('${vImage}','${vName1}')" >
                            <div class="image-tag " >
                                <img  loading="lazy"onmouseover="dis_image_enlarge('${vImage}','${vName1}')" onclick="selectedImage('${vImage}', '${oId}','${vName1}', this,'${parId}', '${str_val}','${valAdd}')" src="${vImage}" data-id="${valId}" data-charge='${str_val}'  />
                            </div>
                            <div class="label" >${vName}</div>
                            <div hidden class="label" >${dc}</div>
                            <div hidden class="label" >${vName},${dk}</div>
                        </div>`;
                    $('div#buttons').append([{oId: 'stockpopup', vImage:valImage , vName1:value_name_add.replace("'","\\'"), vName:value_name_add, vId: valId, parId:pId, dc:designCategory, dk:designKeywords, str_val:str_val,valAdd:valAdd}].map(popupOption).join('')); 
                }
            }
        }   
    
     
    
    }
      function filterCategory(_thisval, _this,id) {
        $("#popSearch"+id).val('');
        $('.catli').each(function(index, element){
            $(element).removeClass('selected');
        });
        $(_this).addClass('selected');
    
        $(".view-option-block").each(function(index, element) {  
            var  lblele = element.children[2];
            const lbl = $(lblele).text();
            if(_thisval == "" || _thisval == "All"){
                $(element).show();
            } else {
                {% comment %} 
                if (lbl.toString().toLowerCase().indexOf(_thisval.toLowerCase()) >= 0) { 
                {% endcomment %}
                    if (lbl.toString().toLowerCase() == _thisval.toLowerCase()) {
                        $(element).show();
                    } else {
                        $(element).hide();
                    }
                {% comment %} 
                }
                {% endcomment %}
            }
        });
    }
  function dis_image_enlarge(imgsrc,imgname) {
  var ttet = imgname;
  var result = ttet.includes("'") ? "Yes" : "No";
  console.log(result,'result');
  $('#img_enlargeImage').attr("src", imgsrc);
  
  console.log(imgsrc,'imgsrc ');
  //$('#img_enlargeImage_p').attr("value", imgname);
  $("#img_enlargeImage_p").html( imgname);
  console.log(imgname,'imgname');
  }
    function popupSearchFilter(_this,popId, id){
        $('.catli').each(function(index, element){
            $(element).removeClass('selected');
        });
        $(".caltliAll").addClass('selected');
    
        $(".view-option-block").each(function(index, element) {  
            var lbl = "";
            if(element.children[3]) {
                var  lblele = element.children[3];
                lbl = $(lblele).text();
            }else{
                var  lblele = element.children[1];
                lbl = $(lblele).text();
            }
    
            {% comment %} 
            var  lblele = element.children[3];
            const lbl = $(lblele).text(); 
            {% endcomment %}
    
            if(_this.value == "") {
                $(element).show();
            } else {
                if (lbl.toString().toLowerCase().indexOf(_this.value.trim().toLowerCase()) >= 0) {
                    $(element).show();
                } else {
                    $(element).hide();
                }
            }
        });
    } 
     
  </script>
    