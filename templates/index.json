============================ -->\n\n  <\/div><!-- \/.hb-blog-inner -->\n<\/section>\n\n<!-- =====================================================\n     STYLES\n     ===================================================== -->\n<style>\n\/* ── Section shell ── *\/\n.hb-blog-section {\n  padding: 24px 20px 20px;\n  background: #f9f7f4;\n  font-family: inherit;\n}\n.hb-blog-inner {\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n\/* ── Header ── *\/\n.hb-blog-header {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 14px;\n}\n.hb-section-title {\n  font-size: 20px;\n  font-weight: 700;\n  color: #1a1a1a;\n  margin: 0;\n  line-height: 1.3;\n}\n.hb-see-all {\n  font-size: 12px;\n  font-weight: 600;\n  color: #b22234;\n  text-decoration: none;\n  white-space: nowrap;\n}\n.hb-see-all:hover { opacity: 0.75; }\n\n\/* ── 3-column blog grid ── *\/\n.hb-blog-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n\/* ── Blog card ── *\/\n.hb-card {\n  display: flex;\n  flex-direction: column;\n  background: #ffffff;\n  border: 1px solid #e4e1db;\n  border-radius: 8px;\n  overflow: hidden;\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n.hb-card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 6px 18px rgba(0,0,0,0.09);\n}\n.hb-card-link {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  text-decoration: none;\n  color: inherit;\n}\n.hb-card-link:hover { text-decoration: none; }\n\n\/* ── Card image ── *\/\n.hb-card-img-wrap {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 3 \/ 2;\n  overflow: hidden;\n  background: #ede9e2;\n  flex-shrink: 0;\n}\n.hb-card-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n  transition: transform 0.35s ease;\n}\n.hb-card:hover .hb-card-img { transform: scale(1.04); }\n.hb-tag {\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  background: #b22234;\n  color: #ffffff;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.5px;\n  text-transform: uppercase;\n  padding: 3px 7px;\n  border-radius: 3px;\n  pointer-events: none;\n}\n\n\/* ── Card body ── *\/\n.hb-card-body {\n  padding: 12px 14px 14px;\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n}\n.hb-card-date {\n  font-size: 11px;\n  color: #999;\n  margin: 0 0 6px;\n}\n.hb-card-title {\n  font-size: 13px;\n  font-weight: 700;\n  color: #1a1a1a;\n  margin: 0 0 6px;\n  line-height: 1.45;\n  flex: 1;\n}\n.hb-card-desc {\n  font-size: 11px;\n  color: #666;\n  line-height: 1.5;\n  margin: 0 0 10px;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n.hb-read-more {\n  font-size: 11px;\n  font-weight: 700;\n  color: #b22234;\n}\n\n\/* ── Footer CTA ── *\/\n.hb-blog-footer {\n  text-align: center;\n  margin-top: 14px;\n}\n.hb-btn-all {\n  display: inline-block;\n  background: #b22234;\n  color: #ffffff;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.3px;\n  padding: 9px 24px;\n  border-radius: 5px;\n  text-decoration: none;\n  transition: background 0.2s;\n}\n.hb-btn-all:hover {\n  background: #8e1a29;\n  color: #ffffff;\n  text-decoration: none;\n}\n\n\/* ── Trustpilot strip ── *\/\n.hb-tp-wrap {\n  margin-top: 16px;\n  background: #ffffff;\n  border: 1px solid #e4e1db;\n  border-radius: 8px;\n  padding: 14px 16px;\n}\n.hb-tp-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 12px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #f0ede8;\n}\n.hb-tp-branding {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n.hb-tp-logo-svg {\n  width: 100px;\n  height: 25px;\n  flex-shrink: 0;\n}\n.hb-tp-overall {\n  font-size: 12px;\n  color: #1a1a1a;\n}\n.hb-tp-overall strong {\n  font-weight: 700;\n}\n.hb-tp-count {\n  font-size: