6d2a39160d","settings":{}},"a943373a-2436-493b-a246-86cdc7215c40":{"type":"shopify:\/\/apps\/wiser-ai-upsell-cross-sell\/blocks\/wiser_related\/3f966edc-9a4a-465c-a4df-436d2a39160d","settings":{}}},"block_order":["f88d1c37-a4cb-496f-87ee-b6c159d9971b","0d55fff4-ceb4-4192-b336-a29bd180bcb6","a943373a-2436-493b-a246-86cdc7215c40"],"settings":{"include_margins":true}},"custom_html_jibM8k":{"type":"custom-html","name":"Custom HTML","settings":{"title":"","html":"<!-- ============================================================\n     HODGES BADGE CO — ABOUT + FAQ COMBINED\n     Shopify Custom Liquid Section\n\n     HOW TO USE:\n     1. In Shopify Admin go to Online Store → Themes → Customize\n     2. On the Home page click \"Add section\"\n     3. Choose \"Custom Liquid\"\n     4. Paste THIS ENTIRE FILE into the Custom Liquid box\n     5. Drag the section to your preferred position\n     6. Click Save\n============================================================ -->\n\n<div style=\"max-width:100%; width:100%; margin:0 auto; padding:30px 40px; font-size:13px; line-height:1.7; color:#555; border-top:1px solid #e8e8e8; box-sizing:border-box;\">\n\n  <!-- ── FAQ SECTION ── -->\n  <h2 style=\"text-align:left; font-size:18px; font-weight:700; margin-bottom:16px; margin-top:0; letter-spacing:0.3px; color:#1a2744;\">\n    Frequently Asked Questions\n  <\/h2>\n\n  <!-- FAQ Item 1 -->\n  <div style=\"border-top:1px solid #e8e8e8;\">\n    <button onclick=\"\n      var a = this.nextElementSibling;\n      var icon = this.querySelector('.faq-plus');\n      if(a.style.display === 'none') {\n        a.style.display = 'block';\n        icon.style.transform = 'rotate(45deg)';\n      } else {\n        a.style.display = 'none';\n        icon.style.transform = 'rotate(0deg)';\n      }\n    \" style=\"width:100%; background:none; border:none; border-bottom:1px solid #e8e8e8; cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:12px 0; text-align:left; font-size:13px; font-weight:400; color:#555; line-height:1.7;\">\n      What makes Hodges custom rosette quality so special?\n      <span class=\"faq-plus\" style=\"flex-shrink:0; width:20px; height:20px; border-radius:50%; border:1.5px solid #c8a96e; display:flex; align-items:center; justify-content:center; color:#c8a96e; font-size:16px; line-height:1; transition:transform .3s;\">+<\/span>\n    <\/button>\n    <div style=\"display:none; padding:8px 0 12px;\">\n      <p style=\"margin-bottom:12px;\">What makes a truly exceptional rosette? It starts with quality ribbon material. We use premium satin ribbon stock that holds its pleat, maintains its color, and keeps its body year after year. Visit any longtime exhibitor's trophy room, and you'll see the difference, our rosettes from years ago still look crisp and vibrant, while cheaper alternatives have curled, faded, or deteriorated.<\/p>\n      <p style=\"margin-bottom:12px;\">Construction expertise matters. Our rosettes are handcrafted daily by our dedicated team in our Missouri factory. Each rosette features secure centers, streamers that hang properly, and pleating, points and petals that's both beautiful and durable. We understand that these awards need to withstand being pinned to dogs, attached to crates, photographed repeatedly, and displayed in trophy rooms. We build them to last.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- FAQ Item 2 -->\n  <div>\n    <button onclick=\"\n      var a = this.nextElementSibling;\n      var icon = this.querySelector('.faq-plus');\n      if(a.style.display === 'none') {\n        a.style.display = 'block';\n        icon.style.transform = 'rotate(45deg)';\n      } else {\n        a.style.display = 'none';\n        icon.style.transform = 'rotate(0deg)';\n      }\n    \" style=\"width:100%; background:none; border:none; border-bottom:1px solid #e8e8e8; cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:12px 0; text-align:left; font-size:13px; font-weight:400; color:#555; line-height:1.7;\">\n      Can I order personalized rosettes with my event logo?\n      <span class=\"faq-plus\" style=\"flex-shrink:0; width:20px; height:20px; border-radius:50%; border:1.5px solid #c8a96e; display:flex; align-items:center; justify-content:center; color:#c8a96e; font-size:16px; line-height:1; transition:transform .3s;\">+<\/span>\n    <\/button>\n    <div style=\"display:none; padding:8px 0 12px;\">\n      <p style=\"margin-bottom:12px;\">Yes! Hodges Badge Company makes it easy to order fully personalized rosettes featuring your event logo and branding. Every rosette in the Hodges Badge collection can be customized with your organization's name, event title, show date, placement text, and logo or artwork incorporated into the rosette center design. This means your Champion, Reserve Champion, or Grand Champion rosettes can carry your unique brand identity, making them even more meaningful to the competitors who earn them. Personalized logo rosettes are a popular choice for horse shows, dog shows, county fairs, 4-H programs, and equestrian associations that want a polished, professional award presentation. Use the design tools at hodgesbadge.com to start building your custom logo rosettes or call 1-800-556-2440 for hands-on design assistance from our customization team.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- FAQ Item 3 -->\n  <div>\n    <button onclick=\"\n      var a = this.nextElementSibling;\n      var icon = this.querySelector('.faq-plus');\n      if(a.style.display === 'none') {\n        a.style.display = 'block';\n        icon.style.transform = 'rotate(45deg)';\n      } else {\n        a.style.display = 'none';\n        icon.style.transform = 'rotate(0deg)';\n      }\n    \" style=\"width:100%; background:none; border:none; border-bottom:1px solid #e8e8e8; cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:12px 0; text-align:left; font-size:13px; font-weight:400; color:#555; line-height:1.7;\">\n      What is the difference between flat ribbons and rosettes for awards?\n      <span class=\"faq-plus\" style=\"flex-shrink:0; width:20px; height:20px; border-radius:50%; border:1.5px solid #c8a96e; display:flex; align-items:center; justify-content:center; color:#c8a96e; font-size:16px; line-height:1; transition:transform .3s;\">+<\/span>\n    <\/button>\n    <div style=\"display:none; padding:8px 0 12px;\">\n      <p style=\"margin-bottom:12px;\">Great question! Both flat ribbons and rosettes are popular award choices for horse shows, dog shows, fairs, and competitions, but they differ in style, appearance, and occasion. Flat award ribbons are the traditional straight ribbon style, typically used for everyday placements like 1st through 6th place. They are simple, cost-effective, and classic. Rosettes, on the other hand, feature a decorative gathered or pleated center (the \"rosette\") with streamers hanging below, creating a more dramatic, premium look. Rosettes are often used for Champion, Reserve Champion, Grand Champion, Best in Show, or placement awards that deserve to stand out. At Hodges Badge Company, you'll find both flat award ribbons and custom rosettes in a wide range of styles, all fully customizable for your event. Explore our broad selection of awards at hodgesbadge.com or call 1-800-556-2440 to discuss what's right for your show.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- FAQ Item 4 -->\n  <div>\n    <button onclick=\"\n      var a = this.nextElementSibling;\n      var icon = this.querySelector('.faq-plus');\n      if(a.style.display === 'none') {\n        a.style.display = 'block';\n        icon.style.transform = 'rotate(45deg)';\n      } else {\n        a.style.display = 'none';\n        icon.style.transform = 'rotate(0deg)';\n      }\n    \" style=\"width:100%; background:none; border:none; border-bottom:1px solid #e8e8e8; cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:12px 0; text-align:left; font-size:13px; font-weight:400; color:#555; line-height:1.7;\">\n      What is the turnaround time for rosette orders?\n      <span class=\"faq-plus\" style=\"flex-shrink:0; width:20px; height:20px; border-radius:50%; border:1.5px solid #c8a96e; display:flex; align-items:center; justify-content:center; color:#c8a96e; font-size:16px; line-height:1; transition:transform .3s;\">+<\/span>\n    <\/button>\n    <div style=\"display:none; padding:8px 0 12px;\">\n      <p style=\"margin-bottom:12px;\">Turnaround time for custom rosette orders at Hodges Badge Company is typically 7–12 working days, but can vary depending on the rosette style, level of customization, and order quantity. For fully custom rosettes, including Championship Line and Deluxe Rosettes with personalized centers and streamers, it's recommended to place your order 4 weeks before your event to allow time for design approval, production, and shipping.<\/p>\n      <p style=\"margin-bottom:12px;\">For shows with tighter deadlines, Hodges Badge offers rush shipping services, a dedicated Express Line of award products with faster turnaround times, and Quick Ship stock rosette awards so you don't have to sacrifice quality when time is short. To get a specific production timeline for your rosette order, visit hodgesbadge.com or call 1-800-556-2440 and our team will walk you through the best options for your schedule.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- FAQ Item 5 -->\n  <div>\n    <button onclick=\"\n      var a = this.nextElementSibling;\n      var icon = this.querySelector('.faq-plus');\n      if(a.style.display === 'none') {\n        a.style.display = 'block';\n        icon.style.transform = 'rotate(45deg)';\n      } else {\n        a.style.display = 'none';\n        icon.style.transform = 'rotate(0deg)';\n      }\n    \" style=\"width:100%; background:none; border:none; border-bottom:1px solid #e8e8e8; cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:12px 0; text-align:left; font-size:13px; font-weight:400; color:#555; line-height:1.7;\">\n      What are Quick Ship Awards?\n      <span class=\"faq-plus\" style=\"flex-shrink:0; width:20px; height:20px; border-radius:50%; border:1.5px solid #c8a96e; display:flex; align-items:center; justify-content:center; color:#c8a96e; font-size:16px; line-height:1; transition:transform .3s;\">+<\/span>\n    <\/button>\n    <div style=\"display:none; padding:8px 0 12px;\">\n      <p style=\"margin-bottom:12px;\">Quick Ship Awards are a special line of awards that, when ordered by phone, can ship in 24 hours if you ask for this service and if the order is placed by Noon EST. These awards ship with no premium processing fees, though air shipping may apply depending on your location and requested delivery date. When ordering Quick Ship Awards on the web, the earliest you can schedule delivery is in 3 days.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- Footer link -->\n  <p style=\"margin-top:16px; text-align:center; font-size:12px; color:#555;\">\n    Need more information? <a href=\"https:\/\/hodgesbadge.com\/a\/help\" style=\"color:#c8a96e; font-weight:600; text-decoration:none; border-bottom:1px solid #c8a96e; padding-bottom:1px; letter-spacing:0.5px;\">Visit our Help Center<\/a>\n  <\/p>\n\n  <!-- ── DIVIDER ── -->\n  <div style=\"border-top:1px solid #e8e8e8; margin:24px 0;\"><\/div>\n\n  <!-- ── ABOUT SECTION ── -->\n  <h2 style=\"text-align:left; font-size:18px; font-weight:700; margin-bottom:16px; margin-top:0; letter-spacing:0.3px;\">\n    <a href=\"https:\/\/hodgesbadge.com\/pages\/about-us\" style=\"color:#1a2744; text-decoration:none;\">About Hodges Badge Company, Inc.<\/a>\n  <\/h2>\n\n  <p style=\"margin-bottom:12px;\">Hodges Badge Company is America's premier supplier of custom award ribbons, rosettes, medals, trophies, and recognition awards, trusted by dog show clubs, equestrian competitions, county fairs, 4-H programs, schools, and sports organizations across the United States. Family-owned and operated, headquartered in Portsmouth, Rhode Island, with offices and manufacturing in Washington, Missouri, we have been designing and manufacturing high-quality custom awards since 1920, combining traditional craftsmanship with modern customization options that let every organizer create something truly special for their winners.<\/p>\n\n  <p style=\"margin-bottom:12px;\">Whether you're searching for custom rosette ribbons for a horse show, award medals for a swim meet, perpetual trophies for a dog show club, or recognition plaques for employee appreciation, Hodges Badge has the expertise and the product range to deliver. We serve event organizers, show secretaries, athletic directors, fair committees, and businesses of all sizes, offering everything from fully customized designs to our Express Line for fast turnaround orders. With hundreds of styles, colors, and materials to choose from, including acrylic, crystal, silver, birchwood, and resin awards, we make it easy to find the perfect award for any occasion and any budget.<\/p>\n\n  <div id=\"hodges-more-text\" style=\"display:none;\">\n    <p style=\"margin-bottom:12px;\">At Hodges Badge, we understand that a great award is more than a prize, it's a lasting memory. That's why our team works closely with customers to get every detail right, from ribbon color and print to medal finish and engraving. Ordering custom awards has never been easier: browse our full catalog online, use our design tools to explore colors and styles, or call our award specialists at 1-800-556-2440. With fast shipping, competitive pricing, and over a century of experience serving America's top competitions and events, Hodges Badge Company is the name judges, organizers, and champions trust.<\/p>\n    <p style=\"margin-bottom:12px;\">\n      <a href=\"https:\/\/hodgesbadge.com\/pages\/about-us\" style=\"color:#1a2744; font-weight:600; text-decoration:underline;\">Read more about Hodges Badge Company →<\/a>\n    <\/p>\n  <\/div>\n\n  <button id=\"hodges-read-more-btn\" onclick=\"\n    var el = document.getElementById('hodges-more-text');\n    var btn = document.getElementById('hodges-read-more-btn');\n    if (el.style.display === 'none') {\n      el.style.display = 'block';\n      btn.textContent = 'Read Less ▲';\n    } else {\n      el.style.display = 'none';\n      btn.textContent = 'Read More ▼';\n    }\n  \" style=\"background:none; border:none; color:#c8a96e; font-size:12px; font-weight:600; cursor:pointer; padding:0; margin-top:4px; letter-spacing:0.5px;\">\n    Read More ▼\n  <\/button>\n\n<\/div>"}},"rich_text_kXFQHR":{"type":"rich-text","name":"Rich text","settings":{"show_section":false,"heading_color":"#000000","text_color":"#000000","text_width":"narrow","title":"About Hodges Badge Company, Inc.","content":"<p>Use this text to share information about your brand with your customers.<br\/>Describe a product, share announcements, or welcome customers to your store.<\/p>","button_text":"Our products","button_link":"shopify:\/\/collections\/all"}}},"order":["banner_with_image_GcGnhk","collection-list","1632322954d523e328","pagefly_section_Nq8wxH","custom_liquid_xb3wEt","16357419886b64441b","1636461043975174d8","slideshow_trust_pilot_VKaBVM","16323248663f1cbb61","1702029901f12ab72a","custom_html_jibM8k","rich_text_kXFQHR"]}