<style>
  #main{
    background-color:#f3f5f6;
  }
  .con_top_fixed_full{
    max-width: 1800px;
    background-color: #e7ebee;
  }
  .team{
    margin-top:20px;
    margin-bottom:-20px;
    margin-left:auto;
    margin-right:auto;
      
  }
    .con_header_txt {
        max-width: revert;
        /*max-width: 1626px;*/
        padding: 20px 0px 20px 0px;
        border: 1px solid var(--border-color);
        border: 1px solid var(--border-color);

    }

    @media screen and (min-width: 1000px) {
        .team__block-item {
            width: calc(14.33333% - -23px) ! important;
		border-radius: 19px;
        }

        .mm {
            margin: 2px!important;
        }
     
        
    }


    @media screen and (min-width: 641px) {
        .team__block-item {
            margin: 4px;
            flex: none;
            width: calc(38% - 30px);
          border-radius: 19px;
        }
    }

    @media screen and (max-width: 641px) {
        .team__block-item {
/*             width: calc(51.33333% - 8px); */
           width: calc(47.33333% - 8px);
         border-radius: 19px;
        }

        .block_Zero_margin {
            margin: 0px ! important;
        }

        .ml {
            margin: 0px;
        }

        .team__block-list {
            display: flex;
            /* justify-content: center; */
            flex-wrap: wrap;
            border-radius: 0px;
        }
    }

    .team__member {
/*         border-radius: 0px; */
        padding: 5px 5px 5px 5px ! important;
        border: 1px solid var(--border-color) ! important;
        /* border-radius: 3px; */
        background: var(--secondary-background) ! important;
    }

    .title_head {
        border: 1px solid var(--border-color) ! important;
        background-color: white;
    }
</style>
<div class="container con_top_fixed_full" style="background-color: #b28e44;padding:10px;">
