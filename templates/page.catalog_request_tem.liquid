        function openFormPopUp() {
            document.getElementById("myFormPopUp").style.display = "block";
        }
        function closeFormPopUp() {
            document.getElementById("myFormPopUp").style.display = "none";
            a.style.display = 'none';
            b.style.display = 'block';
        }
        function toggle(id) {
            var mail = document.mform.email.value;
            var m = /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
           
             if(mail==""){
                document.getElementById("bug").innerHTML = "Email is required *";
                 status = false;
             }
                 else if (!m.test(mail)) {
            document.mform.email.focus;
            document.getElementById("bug").innerHTML = "Invalid email address *";
            status = false;
            }
         else {
            document.mform.email.focus;
            document.getElementById("bug").innerHTML = "";
            status = true;
        }
        if (m.test(mail)==true) {
            a = document.getElementById('toggle_' + id);
            b = document.getElementById('display_' + id);
            if (a.style.display == 'block') {
                a.style.display = 'none';
                b.innerHTML = 'Show Discussion';
            }
            else {
                a.style.display = 'block';
                b.style.display = 'none';
            }
        }
          mform.reset();
        }
      
      
   

