{%- capture section_settings -%}
{
  "showShippingEstimator": {% if cart.item_count == 0 %}false{% else %}{{ section.settings.show_shipping_estimator | json }}{% endif %}
}
{%- endcapture -%}

  {%- assign minOrderAmount = 0 -%}
  {%- assign setupAmount = 0 -%}
  {%- assign hiddenCharges = 0 -%}
  {%- assign flatCharges = 0 -%}
  {%- assign flatChargeItems = "" -%}
  {% comment %} {%- assign addCharges = 0 -%} {% endcomment %}
  {%- assign ppCharges = 0 -%}
  {%- assign moaAlertAmount = 0  -%}
  {%- assign isCustomRideQty = false -%}
   {%- assign acCharge = false  -%}
  {%- assign RemoveBuyButton =  shop.metafields.helpText.RemoveAddtoCartButton.value -%}
  {%- assign  removedPrintColor =  shop.metafields.helpText.RemovedPrintColor.value -%} 
  {%- assign  removedOptionIds =  shop.metafields.helpText.RemovedOptionIds.value | parse_json -%}
 {% comment %} <button type="button" onclick="clearCart();" >ClearCart</button> {% endcomment %}
<section data-section-id="{{ section.id }}" data-section-type="cart" data-section-settings='{{ section_settings }}' data-item-count="{{ cart.item_count }}">
  {%- if cart.item_count == 0 -%}
    <div class="container">
      <div class="empty-state">
        <div class="empty-state__icon">
          {%- render 'icon', icon: 'big-cart' -%}
        </div>

        <p class="empty-state__heading heading h1">{{ 'cart.general.empty' | t }}</p>

        {%- if settings.cart_show_free_shipping_threshold -%}
          {%- assign threshold_in_cents = settings.cart_free_shipping_threshold | times: 100 -%}
          {%- capture remaining_amount -%}<span>{{ cart.total_price | minus: threshold_in_cents | abs | money }}</span>{%- endcapture -%}
          <p class="empty-state__description">{{ 'cart.general.free_shipping_remaining_html' | t: remaining_amount: remaining_amount }}</p>
        {%- endif -%}

        <div class="empty-state__button-container">
          <a href="{{ settings.cart_empty_button_link | default: routes.root_url }}" class="empty-state__button button button--primary">{{ 'cart.general.empty_button' | t }}</a>
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="container">
        {%- comment -%} ── Print-only cart header (hidden on screen via cart-print.css) ── {%- endcomment -%}
      <div class="cart-print-summary" aria-hidden="true">
        <div class="cart-print-summary__logo-row">
          <div class="cart-print-summary__logo">
            {%- if settings.logo != blank -%}
              <img src="{{ settings.logo | img_url: '220x' }}" alt="{{ shop.name }}">
            {%- else -%}
              <p class="cart-print-summary__shop">{{ shop.name }}</p>
            {%- endif -%}
          </div>
          {% comment %} <p class="cart-print-summary__tagline">Cart / Quote Request</p> {% endcomment %}
        </div>
        <div class="cart-print-summary__meta-row">
          <p class="cart-print-summary__meta">
           
            Printed: {{ 'now' | date: '%B %d, %Y' }}
          </p>
          {%- if customer -%}
          <p class="cart-print-summary__customer">
            Customer: {{ customer.name }}<br>
            Email: {{ customer.email }}<br>
            Phone:{{ customer.phone }}
          </p>
          {%- endif -%}
        </div>
      </div>
      <header class="page__header page__header--stack">
        <h1 class="page__title heading h1">{{ 'cart.general.title' | t }}</h1>
        <span id="calendaralerts" style="color:red; "></span>
         <script type="text/javascript" >
           document.getElementById("calendaralerts").textContent = localStorage.getItem("calendaralertText");
         </script>
         
        <span id="movmessagespan" style="color:red; display: none;"> </span>
        {%- if settings.cart_show_free_shipping_threshold -%}
          {%- assign threshold_in_cents = settings.cart_free_shipping_threshold | times: 100 -%}

          {%- if cart.total_price >= threshold_in_cents -%}
            <p class="page__description">{{ 'cart.general.free_shipping' | t }}</p>
          {%- else -%}
            {%- capture remaining_amount -%}<span>{{ cart.total_price | minus: threshold_in_cents | abs | money }}</span>{%- endcapture -%}
            <p class="page__description">{{ 'cart.general.free_shipping_remaining_html' | t: remaining_amount: remaining_amount }}</p>
          {%- endif -%}
        {%- endif -%}
      </header>
    </div>

    <div class="cart-wrapper">
      <div class="cart-wrapper__inner">
        <div class="cart-wrapper__inner-inner">
          <div class="container container--flush">

          {%- comment -%}
