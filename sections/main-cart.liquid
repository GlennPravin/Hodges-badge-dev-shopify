            <div id="popup1" class="overlay" >
              <a  onclick="popUpClose()" class="close" >&times;</a>  
              <div id="enlargeImage" class="enlarging" >
             <h1 id="img_enlargeImage_p" class="enlarge_image_h1" ></h1>
                <img alt="" loading='lazy'  id="img_enlargeImage" src="" class="img_enlarge"  >                               
              </div>
             </div>
            <div class="card">
              <div class="table-wrapper">
                <!-- <table class="line-item-table table table--loose"> -->
                   <table class="line-item-table table table-responsive table--loose " >
                  <thead class="hidden-phone">
                    <tr>
                      <th>{{ 'customer.order.product' | t }}</th>
                      <th class="table__cell--center">{{ 'customer.order.quantity' | t }}</th>
                      <th class="table__cell--right">Price</th>
                      <th class="table__cell--right">{{ 'customer.order.total' | t }}</th>
                    </tr>
                  </thead>
                

                  <tbody>
                    {%- assign gift_wrap_product = section.settings.gift_wrap_product -%}

                    {%- for line_item in cart.items -%}
                      {% if line_item.product.type != 'HiddenCharges' %}
                      <script>
                       cart_productSubType[
                       {{ line_item.properties["_hopsId"] | json }}
                      ] = {{ line_item.product.metafields.ProductMeta.ProductAdditionalInfo.value.ExtraInfoAboutProduct.ProductSubType | append: '' | json }};
                      </script>
                      {%- endif -%}
                      {%- if line_item.properties['_Base Additional Charge'] -%}
                          {%- assign acCharge = true  -%}
                         {%- endif -%}
 
                      {% if line_item.product.type  == 'HiddenCharges' %}
                       
                      {% if line_item.title  contains 'Premium Processing Charges' %}
                        <script type="text/javascript" >
                          
                          document.getElementById("calendaralerts").textContent = "{{line_item.properties['_alertText']}}";
                       </script>
