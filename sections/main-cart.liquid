 const setupCharges = {{shop.metafields.setupcharge | json}};
 const premiumProcessingCharges = {{shop.metafields.PPFee | json}};
 let shipCalendar = {%- if shop.metafields.ShipCalender.value != blank -%}{{ shop.metafields.ShipCalender.value | json }}{%- else -%}{{ shop.metafields.ShipCalender | json }}{%- endif -%};
 const CalendarAlerts = {{shop.metafields.CalenderAlerts | json}};
 const shopPermanentDomain = {{ shop.permanent_domain | json }};
const stockProductType = "{{ shop.metafields.helpText.StockProductType.value }}";
 var popup_Options = {{shop.metafields.CommonOptions | json}};
 const flatCharges = {{shop.metafields.FlatCharges | json}};
{% assign promotionCartHandle = shop.metafields.helpText.PromotionCollectionName.value | parse_json | first | default: "" %}
const PromotionCart = "{{ promotionCartHandle }}";
{% if promotionCartHandle != "" and collections[promotionCartHandle] != nil and collections[promotionCartHandle].products.size > 0 %}
  const PromotionProductsCart = {{ collections[promotionCartHandle].products | map: "id" | json }};
