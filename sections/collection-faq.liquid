{%- liquid
  assign faq_metafield = collection.metafields.global.faq_schema
-%}

{%- if faq_metafield != blank and faq_metafield.value != blank -%}
  {{ 'collection-faq.css' | asset_url | stylesheet_tag }}

  <div id="CollectionFaqMount-{{ section.id }}" hidden></div>
  <script type="application/json" id="CollectionFaqData-{{ section.id }}">{{ faq_metafield.value | json }}</script>
  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var heading = {{ section.settings.heading | json }};
      var dataEl = document.getElementById('CollectionFaqData-' + sectionId);
      var mountEl = document.getElementById('CollectionFaqMount-' + sectionId);
      if (!dataEl || !mountEl) return;

      function parseFaqPayload(rawText) {
        var parsed;
        try {
          parsed = JSON.parse(rawText);
        } catch (e) {
          return null;
        }
        if (typeof parsed === 'string') {
          try {
            parsed = JSON.parse(parsed);
          } catch (e) {
            return null;
          }
        }
        return parsed && typeof parsed === 'object' ? parsed : null;
      }

      function normalizeItems(mainEntity) {
        if (!mainEntity) return [];
        if (Array.isArray(mainEntity)) return mainEntity;
        if (typeof mainEntity === 'object' && mainEntity.name) return [mainEntity];
        return [];
      }

      var faqData = parseFaqPayload(dataEl.textContent);
      var items = normalizeItems(faqData && faqData.mainEntity).filter(function (item) {
        return item && item.name;
      });

      if (!items.length) {
        dataEl.remove();
        mountEl.remove();
        return;
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      var listHtml = items.map(function (item, index) {
        var itemId = 'collection-faq-' + sectionId + '-' + (index + 1);
        var question = escapeHtml(item.name);
        var answer = item.acceptedAnswer && item.acceptedAnswer.text != null
          ? String(item.acceptedAnswer.text)
          : '';

        return (
          '<div class="faq__item">' +
            '<div class="faq__item-wrapper">' +
              '<button class="faq__question" type="button" aria-expanded="false" aria-controls="' + itemId + '" data-faq-index="' + index + '">' +
                '<span class="faq__question-text">' + question + '</span>' +
                '<span class="plus-button" aria-hidden="true"></span>' +
              '</button>' +
              '<div id="' + itemId + '" class="faq__answer-wrapper" aria-hidden="true">' +
                '<div class="faq__answer rte">' + answer + '</div>' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      }).join('');

      var headingHtml = heading
        ? '<header class="section__header"><h2 class="section__title faq__title">' + escapeHtml(heading) + '</h2></header>'
        : '';

      var sectionHtml =
        '<section class="section collection-faq" data-section-id="' + escapeHtml(String(sectionId)) + '" data-section-type="collection-faq">' +
          '<div class="container">' +
            headingHtml +
            '<div class="faq">' +
              '<div class="faq__group-list"><div class="faq__group">' + listHtml + '</div></div>' +
            '</div>' +
          '</div>' +
        '</section>';

      var schemaEl = document.createElement('script');
      schemaEl.type = 'application/ld+json';
      schemaEl.textContent = JSON.stringify(faqData);

      var fragment = document.createRange().createContextualFragment(sectionHtml);
      var insertedSection = fragment.querySelector('.collection-faq');
      mountEl.replaceWith(fragment);
      if (insertedSection && insertedSection.parentNode) {
        insertedSection.parentNode.insertBefore(schemaEl, insertedSection.nextSibling);
      }

      dataEl.remove();

      if (!insertedSection) return;

      var activeQuestionIndex = -1;

      function setActiveQuestion(nextIndex) {
        var buttons = insertedSection.querySelectorAll('.faq__question');
        buttons.forEach(function (button, index) {
          var panel = document.getElementById(button.getAttribute('aria-controls'));
          var isOpen = nextIndex === index;
          button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          if (!panel) return;
          panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
          if (isOpen) {
            panel.classList.add('is-open');
          } else {
            panel.classList.remove('is-open');
          }
        });
        activeQuestionIndex = nextIndex;
      }

      insertedSection.addEventListener('click', function (event) {
        var button = event.target.closest('.faq__question');
        if (!button || !insertedSection.contains(button)) return;

        var clickedIndex = parseInt(button.getAttribute('data-faq-index'), 10);
        if (isNaN(clickedIndex)) return;

        if (activeQuestionIndex === clickedIndex) {
          setActiveQuestion(-1);
          return;
        }

        setActiveQuestion(clickedIndex);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Collection FAQ",
  "templates": ["collection"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "Collection FAQ"
    }
  ]
}
{% endschema %}
