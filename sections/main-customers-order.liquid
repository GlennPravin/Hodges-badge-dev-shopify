<script>
 let chargeCode=[];
 let reorder=[];
 let myAcc_productSubType = {};
 let lineItem1 = {{order.line_items  | json}};
 const myAcc_minLimits = {{shop.metafields.MOAType | json}};
 const myAcc_commonOptions = {{shop.metafields.CommonOptions| json}}
 const myAcc_VariationOptions = {{shop.metafields.VariationOptions| json}}
 const myAcc_moaAmnts = {{shop.metafields.helpText.MOAID | json}};
 const myAcc_flatCharges = {{shop.metafields.FlatCharges | json}};
 const myAcc_setupCharges = {{shop.metafields.setupcharge | json}};
 const myAcc_flatChargeVariants = {{shop.metafields.FlatChargeVariants | json}};
 const myAcc_SetupChargeVariants = {{shop.metafields.SetupChargeVariants | json}};
 const myAcc_printonBackLines = {{ shop.metafields.printOnBackLines.optionIds.value| split: "," | json }};
 const myAcc_printonBack = {{ shop.metafields.printOnBack.optionIds.value | split: "," | json }};
{%- assign RemoveBuyButton =  shop.metafields.helpText.RemoveAddtoCartButton.value -%}

const subTypeIds = {{ shop.metafields.ProductSubType.subTypeIds | split: "," | json}}
const excludeProductsSC = {{ shop.metafields.ExcludeProductsSC.ProductIds | split: "," | json}}

{% assign promotionReorderHandle = shop.metafields.helpText.PromotionCollectionName.value | parse_json | first | default: "" %}
const PromotionReorder = "{{ promotionReorderHandle }}";
{% if promotionReorderHandle != "" and collections[promotionReorderHandle] != nil and collections[promotionReorderHandle].products.size > 0 %}
  const PromotionProductsReorder = {{ collections[promotionReorderHandle].products | map: "id" | json }};
{% else %}
  const PromotionProductsReorder = [];
{% endif %}

{%- for line_item in order.line_items -%}
   {%- if line_item.product.type != 'HiddenCharges' and line_item.product != null and all_products[line_item.product.handle] != empty -%}
      chargeCode.push({ {{line_item.product.id}}:{{ all_products[line_item.product.handle].metafields.chargecode|json}} })
      myAcc_productSubType[{{ line_item.properties["_hopsId"] | json }}] ={{ all_products[line_item.product.handle].metafields.ProductMeta.ProductAdditionalInfo.value.ExtraInfoAboutProduct.ProductSubType | append: '' | json }};
    {% endif %}
	{%- if line_item.product != null and all_products[line_item.product.handle] != empty -%}
      {%- unless RemoveBuyButton contains line_item.properties["_hopsId"] -%}
      reorder.push({{line_item | json}})
       {%- endunless -%}
    {% endif %}
  {%- endfor -%}
</script>
{% include 'loader' %}
{%- assign is_entirely_fulfilled = false -%}
{%- assign has_one_fulfillment = false -%}
{%- assign acCharges = false -%}
{%- if order.fulfillment_status == 'fulfilled' -%}
  {%- assign has_one_fulfillment = true -%}
  {%- assign is_entirely_fulfilled = true -%}
  {%- assign tracking_numbers = '' -%}

  {%- assign number_of_fulfillable_items = 0 -%}

  {%- for line_item in order.line_items -%}
    {%- assign number_of_fulfillable_items = number_of_fulfillable_items | plus: line_item.quantity -%}
  {%- endfor -%}

  {%- for line_item in order.line_items -%}
    {%- assign tracking_numbers = tracking_numbers | append: line_item.fulfillment.tracking_number | append: ',' -%}

    {%- if line_item.fulfillment.item_count != number_of_fulfillable_items -%}
      {%- assign has_one_fulfillment = false -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign tracking_numbers = tracking_numbers | split: ',' | compact | uniq -%}
{%- endif -%}

<section data-section-id="{{ section.id }}" data-section-type="account">
  <div class="container container--flush">
    <div class="page__sub-header">
      <nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb">
        <ol class="breadcrumb__list" role="list">
          <li class="breadcrumb__item">
            <a class="breadcrumb__link link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a> {%- render 'icon', icon: 'arrow-right' -%}
          </li>

          <li class="breadcrumb__item">
            <a class="breadcrumb__link link" href="{{ routes.account_url }}">{{ 'general.breadcrumb.account' | t }}</a> {%- render 'icon', icon: 'arrow-right' -%}
          </li>

          <li class="breadcrumb__item">
            <a class="breadcrumb__link link" href="{{ routes.account_url }}">{{ 'customer.general.orders' | t }}</a> {%- render 'icon', icon: 'arrow-right' -%}
          </li>

          <li class="breadcrumb__item">
            <span class="breadcrumb__link" aria-current="page">{{ 'customer.order.order_number' | t: order_number: order.name }}</span>
          </li>
        </ol>
      </nav>
    </div>

    <div class="layout">
      <div class="layout__section layout__section--secondary">
        <div class="card card--sticky hidden-pocket">
          <div class="card__section card__section--tight">
            <div class="card__linklist">
              <a href="/pages/account-page#profile" class="card__linklist-item link" data-account-profile-link>My profile</a>
              <a href="{{ routes.account_url }}" class="card__linklist-item link text--strong">{{ 'customer.general.orders' | t }}</a>
              <a href="/pages/account-page#addresses" class="card__linklist-item link">{{ 'customer.general.addresses' | t }}</a>
              <a href="/pages/tax-details" class="card__linklist-item link">My tax-Exempt</a>
              <a href="{{ routes.account_logout_url }}" class="card__linklist-item link" data-no-instant>{{ 'customer.general.logout' | t }}</a>
            </div>
          </div>
        </div>

        <div class="value-picker-wrapper hidden-tablet-and-up">
          <button class="value-picker-button value-picker-button--pill" aria-haspopup="true" aria-expanded="false" aria-controls="account-selector" data-action="open-value-picker">
            {{- 'customer.general.orders' | t -}} {%- render 'icon', icon: 'arrow-bottom' -%}
          </button>

          <div id="account-selector" class="value-picker" aria-hidden="true">
            <div class="value-picker__inner">
              <header class="value-picker__header">
                <span class="value-picker__title text--strong">{{ 'customer.general.my_account' | t }}</span>
                <button class="value-picker__close" data-action="close-value-picker" aria-controls="account-selector" aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
              </header>

              <div class="value-picker__choice-list">
                <a href="/pages/account-page#profile" class="value-picker__choice-item" data-account-profile-link>My profile {% render 'icon', icon: 'check-2' %}</a>
                <a href="{{ routes.account_url }}" class="value-picker__choice-item is-selected">{{ 'customer.general.orders' | t }} {% render 'icon', icon: 'check-2' %}</a>
                <a href="/pages/account-page#addresses" class="value-picker__choice-item">{{ 'customer.general.addresses' | t }} {% render 'icon', icon: 'check-2' %}</a>
                <a href="/pages/tax-details" class="card__linklist-item link">My tax-Exempt {% render 'icon', icon: 'check-2' %}</a>
                <a href="{{ routes.account_logout_url }}" class="value-picker__choice-item" data-no-instant>{{ 'customer.general.logout' | t }} {% render 'icon', icon: 'check-2' %}</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="layout__section">
        <div class="order-summary card">
          <div class="card__header card__header--tight">
            <div class="card__navigation">
              <a href="{{ routes.account_url }}" class="card__navigation-breadcrumb link">{% render 'icon', icon: 'arrow-left' %} {{ 'customer.order.back_to_orders' | t }}</a>
              <p class="hidden-phone">{{ order.created_at | date: format: 'month_day_year_time' }}</p>
            </div>
            <div class="row">
              <div class="column" style="width: 50%; padding: 10px;">
                <h1 class="card__title heading h1">{{ 'customer.order.order_number' | t: order_number: order.name }} </h1> 
              </div>
              <div class="column" style="width: 50%; padding: 10px;">
                <button onclick="myAccountAddtoCart(reorder)" type="button" class="reorder__button" style="width:50%;float:right;font-weight: bold; border:none; border-radius: 2px; background-color: #ae1a1a; color:white; padding:10px;"> ReOrder </button>
              </div>
            </div>
            <p class="hidden-tablet-and-up">{{ order.created_at | date: format: 'month_day_year_time' }}</p>

            {%- if order.cancelled -%}
              {%- capture cancellation_date -%}{{ order.cancelled_at | date: format: 'month_day_year_time' }}{%- endcapture -%}

              <div class="order-summary__alert">
                <p class="alert alert--large alert--error">{{ 'customer.order.cancelled_at' | t: date: cancellation_date, reason: order.cancel_reason_label }}</p>
              </div>
            {%- elsif is_entirely_fulfilled and has_one_fulfillment -%}
              {%- assign fulfillment = '' -%}

              {%- for line_item in order.line_items -%}
                {%- if line_item.fulfillment -%}
                  {%- assign fulfillment = line_item.fulfillment -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
  
{% comment %}                <div class="order-summary__alert">
               
                {%- if fulfillment.tracking_url != blank and fulfillment.tracking_number != blank -%}
                  <p class="alert alert--large alert--success">{{ 'customer.order.fulfillment_with_url_and_number_html' | t: tracking_url: fulfillment.tracking_url, tracking_number: fulfillment.tracking_number }}</p>
                {%- elsif fullfillment.tracking_url != blank -%}
                  <p class="alert alert--large alert--success">{{ 'customer.order.fulfillment_with_url_html' | t: tracking_url: fulfillment.tracking_url }}</p>
                {%- elsif fullfilment.tracking_number != blank -%}
                  <p class="alert alert--large alert--success">{{ 'customer.order.fulfillment_with_number_html' | t: tracking_number: fulfillment.tracking_number }}</p>
                {%- else -%}
                  <p class="alert alert--large alert--success">{{ 'customer.order.fulfillment_html' | t }}</p>
                {%- endif -%}
              </div> {% endcomment %}
            {%- endif -%}
             {%- if order.metafields.TrakingNumbers.TrakingNumberURL != "" -%}
          
             {%- for trackNum in order.metafields.TrakingNumbers.TrakingNumberDetails.TrakingNumbers -%}
               <p class="alert alert--large alert--success">YOUR TRACKING NUMBER IS {{trackNum}},  <a href="{{  order.metafields.TrakingNumbers.TrakingNumberURL | append : trackNum  }}" class="link text--strong">click here to track the package</a></p>
             {%- endfor -%}
          
<!--           		  <p class="alert alert--large alert--success">Tracking : {{order.metafields.TrakingNumbers.TrakingNumberURL}}</p> -->
          
            {%- endif -%}  
          </div>
          
                  
 
           <div class="table-responsive{-sm|-md|-lg|-xl} table-responsive-sm table-responsive-md table-responsive-lg table-responsive-xl re_respon">
            <table class="table table_reorder_respon">         
              <thead>
                <tr class="head_tr_row">
                  <th class="pro_respon"> Product </th>
                  <th class="table__cell--center">Quantity</th>
                  <th class="table__cell--right">Price</th>
                 <th class="table__cell--right tabhead_respon">Total</th>
                </tr>
              </thead>

                  {%- assign minOrderAmount = 0 -%}
                  {%- assign setupAmount = 0 -%}
                  {%- assign hiddenCharges = 0 -%}
                  {%- assign flatCharges = 0 -%}
                  {%- assign flatChargeItems = "" -%}
                  {% comment %} {%- assign addCharges = 0 -%} {% endcomment %}
                  {%- assign ppCharges = 0 -%}

              <tbody>
                {%- for line_item in order.line_items -%}
                  {% if line_item.title contains 'Additional Charges' %}
                     {%- assign acCharges = true -%}
                  {% endif %}
                  {% if line_item.product.type  == 'HiddenCharges' %}
                      {% if line_item.title  contains 'Premium Processing Charges' %}
                           {%- assign ppCharges = line_item.final_price | times: line_item.quantity -%}
                           {%- assign hiddenCharges = hiddenCharges | plus:ppCharges  -%}
                        {% endif %}
                        {% if line_item.title  contains 'Minimum Order Amount' %}
                           {%- assign minOrderAmount = line_item.final_price -%}
                           {%- assign hiddenCharges = hiddenCharges | plus:minOrderAmount  -%}
                        {% endif %}
                        {% if line_item.title  contains 'Setup Charges' %}
                           {%- assign tempSetupAmount = line_item.final_price | times: line_item.quantity -%}
                           {%- assign setupAmount = setupAmount | plus:tempSetupAmount  -%}
                           {%- assign hiddenCharges = hiddenCharges | plus:tempSetupAmount  -%}
                        {% endif %}
                         {% if line_item.title  contains 'Flat Charges' %}
                           {% assign LineitemAmnt = line_item.final_price | times: line_item.quantity %}
                            {% if flatChargeItems=="" %}
                              {%- assign flatChargeItems = flatChargeItems | append:line_item.properties['ChargeType'] | append:':' | append:LineitemAmnt  -%}
                            {% else %}
                              {% assign flatItems = flatChargeItems | split: "," %}
                              {% for item in flatItems %}
                                {%- assign itemCheck = line_item.properties['ChargeType']-%}
                                {% assign itemVal = item | split: ":" %}
                                {% if itemCheck == itemVal[0]%}
                                  {%- assign itemValCharges =  itemVal[1] | plus: LineitemAmnt -%} 
                                  {%- assign replaceItem = itemVal[0] | append:':' | append:itemValCharges -%}
                                  {%- assign flatChargeItems = flatChargeItems | replace: item, replaceItem -%}
                                {% else %}
                                  {%- assign flatChargeItems = flatChargeItems | append:',' | append:line_item.properties['ChargeType'] | append:':' | append:LineitemAmnt  -%}
                                {% endif %}
                              {% endfor %}
                              
                            {% endif %}
                           
                           {%- assign flatCharges = flatCharges | plus:LineitemAmnt -%}
                           {%- assign hiddenCharges = hiddenCharges | plus:LineitemAmnt  -%}
                         
                        {% endif %}
                        {% continue %}
                      {% endif %}

                  <tr class="line-item tr_respon_data">
                    <td class="line-item__product-info">
                      <div class="line-item__product-info-wrapper repon_tab">
                        <div class="line-item__image-wrapper">
                          <div class="aspect-ratio aspect-ratio--square">
                            {%- if line_item.properties['_canvasImage'] -%}
                           <img src="{{line_item.properties['_canvasImage']}}" alt="{{ line_item.image.alt | escape }}">
                           {%- else -%}
                            <img src="{{ line_item.image | img_url: '90x90', scale: 2 }}" alt="{{ line_item.image.alt | escape }}">
                           {%- endif -%}  
                          </div>
                        </div>

                        <div class="line-item__meta">
                           <a href="{{ line_item.url }}" class="line-item__title link text--strong ang_line ">{{ line_item.product.title }}</a>
                          <span class="line-item__price">{{ line_item.properties['_hopsId'] }}</span>
                          {%- if line_item.selling_plan_allocation -%}
                            <p class="line-item__plan-allocation">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
                            
                          {%- endif -%}

                          {%- unless line_item.properties == blank -%}
                            <ul class="line-item__property-list" id="unlist_respon" role="list">
                              {%- for property in line_item.properties -%}
                                {%- assign first_character_in_key = property.first | truncate: 1, '' -%}
									  {%- if property.first == 'Base Additional Charge' -%}
                                        {%- continue -%}
                                      {%- endif -%}
                                {%- if property.last == blank or first_character_in_key == '_'  and property.first != '_CustomDesign' and property.first != '_CustomDesignCenter'-%}
                                  {%- continue -%}
                                {%- endif -%}
                                {%- if property.first contains 'CustomDesign' or property.first contains 'CustomDesignCenter' -%}
                                {% assign url_parts = property.last | split: '.' %}
                                {% assign extension = url_parts.last | prepend: 0 %}
								{% assign key = property.first %}
                                       {% if shop.metafields.PreviewIcon[extension] %}
                                         <li class="line-item__property">{{ key |split:'_'}}:<a href="{{ property.last }}"><img loading='lazy'  src="{{ shop.metafields.PreviewIcon[extension].value }}" alt="{{ property.last }}" width="75" height="75"></a></li>
                                       {% else %}
                                         <li class="line-item__property">{{ key |split:'_' }}:<a href="{{ property.last }}"><img loading='lazy'  src="{{ property.last }}" alt="{{ property.last }}" width="75" height="75"></a></li>
                                      {%- endif -%}
                                      {%- else -%}
                                       {%- if property.first contains ".~" -%}
                                          {%- assign prop = property.first | split:".~" -%}
                                          <li class="line-item__property">{{ prop[1] }}: {{ property.last }}</li>
                                        {%- else -%}
                                           <li class="line-item__property">{{ property.first }}: {{ property.last }}</li>
                                        {%- endif -%}

                                     {%- endif -%}
                              {%- endfor -%}
                            </ul>
                          {%- endunless -%}                          
                          {%- if line_item.unit_price_measurement -%}
                            <div class="line-item__price-info">
                              <div class="unit-price-measurement">
                                <span class="unit-price-measurement__price">{{ line_item.unit_price | money }}</span>
                                <span class="unit-price-measurement__separator">/ </span>

                                {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                                  <span class="unit-price-measurement__reference-value">{{ line_item.unit_price_measurement.reference_value }}</span>
                                {%- endif -%}

                                <span class="unit-price-measurement__reference-unit">{{ line_item.unit_price_measurement.reference_unit }}</span>
                              </div>
                            </div>
                          {%- endif -%}

                          {%- if line_item.line_level_discount_allocations != blank -%}
                            <ul class="line-item__discount-list" role="list">
                              {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                                <li class="line-item__discount">
                                  {%- render 'icon', icon: 'sale' -%}{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      </div>
                   {%- assign variations = ''-%}
                        {%- for property in line_item.properties -%}
                          
                          {%- if property.first == "Variation" -%}
                            {%- assign variations = 'isVariant'-%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if variations == "isVariant" -%}
                        {%- else -%}
						{%- if all_products[line_item.product.handle] == empty -%}
							<p style="color:red">{{ shop.metafields.helpText.draftProductMsg.value }}</p>
                         {%- elsif RemoveBuyButton contains line_item.properties['_hopsId']  -%}
                            <p>{{ shop.metafields.helpText.ContactForPurchase.value }}</p> 
                        {%- else -%}
							<button class="btnn_respon" onclick="myAccountAddtoCart(lineItem1,{{forloop.index}});" type="button" style="width:40%;font-weight: bold; border:none; border-radius: 2px; background-color: var(--heading-color); color:white; padding:10px;"> Add to cart </button>
                        {%- endif -%}                        
                        {%- endif -%}            
                    </td>

                    <td class="line-item__quantity table__cell--center break">{{ line_item.quantity }}</td>
                    {%- if line_item.final_line_price == 0 -%}
                      {{- 'cart.general.free' | t -}}
                      {%- else -%}
                         {%- if acCharges -%}
                      {%- assign _baseAc =  line_item.properties['_baseAc'] |  times: 100  -%} 
                      <td class="line-item__line-price table__cell--right break1">{{_baseAc | plus: line_item.final_price | money }}</td>
                         {%- else -%}
                          <!-- {% comment %} {%- assign _baseAc =  line_item.properties['_baseAc'] |  times: 100  -%}  {% endcomment %} -->
                         <td class="line-item__line-price table__cell--right break1">{{ line_item.final_price | money }}</td>
                         {% endif %}
                      {%- endif -%}
                    {%- if line_item.final_line_price == 0 -%}
                      {{- 'cart.general.free' | t -}}
                    {%- else -%}
                        {%- if acCharges -%}
                      {%- assign _totalAc =  line_item.properties['_totalAc'] |  times: 100  -%} 
                      <td class="line-item__line-price table__cell--right break2 tab_total_respon"><div id="my_box2">{{ _totalAc | plus: line_item.final_line_price | money }}</div></td>
                         {%- else -%}
                            {% comment %} {%- assign _totalAc =  line_item.properties['_totalAc'] |  times: 100  -%}  {% endcomment %}
                            <td class="line-item__line-price table__cell--right break2 tab_total_respon"><div id="my_box2">{{ line_item.final_line_price | money }}</div></td>
                         {% endif %}
                    {%- endif -%}
                  </tr>

                  {%- unless is_entirely_fulfilled and has_one_fulfillment -%}
                    {%- if line_item.fulfillment -%}
                      <tr class="fulfillment-item">
                        <td colspan="3">
                          {%- if line_item.fulfillment.tracking_url != blank and line_item.fulfillment.tracking_number != blank -%}
                            <p class="alert alert--large alert--success">{{ 'customer.order.line_fulfillment_with_url_and_number_html' | t: tracking_url: line_item.fulfillment.tracking_url, tracking_number: line_item.fulfillment.tracking_number }}</p>
                          {%- elsif fullfillment.tracking_url != blank -%}
                            <p class="alert alert--large alert--success">{{ 'customer.order.line_fulfillment_with_url_html' | t: tracking_url: line_item.fulfillment.tracking_url }}</p>
                          {%- elsif fullfilment.tracking_number != blank -%}
                            <p class="alert alert--large alert--success">{{ 'customer.order.line_fulfillment_with_number_html' | t: tracking_number: line_item.fulfillment.tracking_number }}</p>
                          {%- else -%}
                            <p class="alert alert--large alert--success">{{ 'customer.order.line_fulfillment_html' | t }}</p>
                          {%- endif -%}
                        </td>
                      </tr>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          <div class="order-foot">
            <div class="order-foot__inner">
                    {%- if hiddenCharges > 0 -%}
                      <div class="order-foot__item order-foot__item">
                        {%- assign merchandiseTotal = order.line_items_subtotal_price | minus: hiddenCharges  -%}
                        <span class="order-foot__item-category"> Merchandise Total </span>
                        <span class="order-foot__item-value">{{ merchandiseTotal | money }} </span> 
                      </div>
                       
                       {%- if setupAmount > 0 -%}
                        <div class="order-foot__item order-foot__item">
                          <span class="order-foot__item-category"> Setup Charges </span>
                          <span class="order-foot__item-value">{{setupAmount | money }} </span> 
                        </div>
                      {%- endif -%}
                      {%- if flatCharges > 0 -%}
                         {% assign flatItems = flatChargeItems | split: "," %}
                           {% for item in flatItems %}
                             {% assign itemVal = item | split: ":" %}
                             {%- assign itemValChargeType = itemVal[0] -%}
                             {%- assign itemValCharges =  itemVal[1]  -%}
                             <div class="order-foot__item order-foot__item">
                               <span class="order-foot__item-category"> {{itemValChargeType}} </span>
                               <span class="order-foot__item-value">{{itemValCharges | money }} </span> 
                             </div>
                           {% endfor %}
                      {%- endif -%}
                     
                      {%- if minOrderAmount > 0 -%}
                       
                        <div class="order-foot__item order-foot__item">
                          <span class="order-foot__item-category"> Miniumum Order Charges </span>
                          <span class="order-foot__item-value">{{minOrderAmount | money }} </span> 
                        </div>
                         
                      {%- endif -%}
                      
                       {%- if ppCharges > 0 -%}
                        <div class="order-foot__item order-foot__item">
                          <span class="order-foot__item-category"> Premium Processing Charges </span>
                          <span class="order-foot__item-value">{{ppCharges | money }} </span> 
                        </div>
                      {%- endif -%}

                    {%- endif -%}
                   <hr/>

              <div class="order-foot__item order-foot__item">
                <span class="order-foot__item-category">{{ 'customer.order.subtotal' | t }}</span>
                <span class="order-foot__item-value">{{ order.line_items_subtotal_price | money }}</span>
              </div>

              {%- for discount_application in order.cart_level_discount_applications -%}
                <div class="order-foot__item order-foot__item--highlight">
                  <span class="order-foot__item-category">{{ 'customer.order.discount' | t }} ({{ discount_application.title }})</span>
                  <span class="order-foot__item-value">-{{ discount_application.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}

              {%- for shipping_method in order.shipping_methods -%}
                <div class="order-foot__item order-foot__item">
                  <span class="order-foot__item-category">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</span>
                  <span class="order-foot__item-value">{{ shipping_method.price | money }}</span>
                </div>
              {%- endfor -%}

              {%- for tax_line in order.tax_lines -%}
                <div class="order-foot__item order-foot__item">
                  {%- if cart.taxes_included -%}
                    <span class="order-foot__item-category">{{ 'customer.order.tax_included' | t }} ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</span>
                  {%- else -%}
                    <span class="order-foot__item-category">{{ 'customer.order.tax_excluded' | t }} ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</span>
                  {%- endif -%}

                  <span class="order-foot__item-value">{{ tax_line.price | money }}</span>
                </div>
              {%- endfor -%}

              {%- if order.total_refunded_amount > 0 -%}
                <div class="order-foot__item order-foot__item">
                  <span class="order-foot__item-category">{{ 'customer.order.refunded_amount' | t }}</span>
                  <span class="order-foot__item-value">{{ order.total_refunded_amount | money }}</span>
                </div>
              {%- endif -%}

              <div class="order-foot__item order-foot__item--strong">
                <span class="order-foot__item-category">{{ 'customer.order.total' | t }}</span>
                <span class="order-foot__item-value">{{ order.total_net_amount | money }}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid">
          <div class="grid__cell 1/2--tablet-and-up">
            <div class="card">
              <div class="card__section">
                <p class="heading h6">{{ 'customer.order.billing_address' | t }}</p>

                {%- if order.billing_address -%}
                  {{- order.billing_address | format_address -}}
                {%- else -%}
                  <p>{{ 'customer.order.no_billing_address' | t }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>

          <div class="grid__cell 1/2--tablet-and-up">
            <div class="card">
              <div class="card__section">
                <p class="heading h6">{{ 'customer.order.shipping_address' | t }}</p>

                {%- if order.shipping_address -%}
                  {{- order.shipping_address | format_address -}}
                {%- else -%}
                  <p>{{ 'customer.order.no_shipping_address' | t }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order"
}
{% endschema %}