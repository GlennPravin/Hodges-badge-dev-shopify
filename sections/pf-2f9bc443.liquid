954574612_1200x.jpeg?v=1647954575" srcSet="https://cdn.shopify.com/s/files/1/0602/3148/3555/t/4/assets/photojoycerivers945gmailcom186776984-1647954574612.jpeg?v=1647954575 1536w" width="637" height="960" sizes="(min-width: 1536px) 1536px, (min-width: 1024px) 1280px, (min-width: 640px) 768px, 320px" loading="lazy"/></div><h3 data-pf-type="Heading" class="sc-bSqaIl iXTDAP pf-753_"><span data-pf-type="Text" class="sc-BHvUt fJlZte pf-755_">This is “Mr. Riggs”, a Sheltie Rescue adopted at age 1, showing off his Championship NADAC ribbon. He earned multiple championships in different venues. The prize money will be donated to the New England Sheltie Rescue who saved this incredibly special boy I was blessed to own. “Mr. Riggs” passed away in 2017 at the age of 17.</span></h3></div></div></div></div></div></div><div class="glide-wrapper"><div style="height:100%" class="sc-iNGGcK sc-jeraig fsLJGn hBfPlE pf-756_ pf-bg-lazy" data-pf-type="Slide2"><div class="glide-container"><div class="sc-clIzBv iQyrr pf-757_ pf-r pf-c-cm pf-r-eh" style="--s-xs:15px" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-gXRojI kCnmwO pf-758_"><h3 data-pf-type="Heading" class="sc-bSqaIl iXTDAP pf-759_"><span data-pf-type="Text" class="sc-BHvUt fJlZte pf-761_">Honorable Mention</span></h3><div data-pf-type="Image" class="sc-iWBNLc NncQz pf-762_"><img src="https://cdn.shopify.com/s/files/1/0602/3148/3555/t/4/assets/photokaterennergmailcom187919534-1647954633383_1200x.jpeg?v=1647954635" srcSet="https://cdn.shopify.com/s/files/1/0602/3148/3555/t/4/assets/photokaterennergmailcom187919534-1647954633383.jpeg?v=1647954635 1536w" width="3024" height="4032" sizes="(min-width: 1536px) 1536px, (min-width: 1024px) 1280px, (min-width: 640px) 768px, 320px" loading="lazy"/></div><h3 data-pf-type="Heading" class="sc-bSqaIl iXTDAP pf-763_"><span data-pf-type="Text" class="sc-BHvUt fJlZte pf-765_">Pictured here is “Baker”, an 11 year old German Shepherd 