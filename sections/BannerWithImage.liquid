<style>
  .align_center_mob_img{
    padding: 0px ! important;
  }
  @media screen and (min-width: 1000px){
  .block_alignment_set{
    /*     min-height: 100px ! important; */
    min-height: 130px ! important;
  }
  }
  .set_width{
    padding:10px ! important;
  }
@media screen and (min-width: 1000px){
/* .promo-block__image-wrapper {
    background-size: 100%;
} */
  
