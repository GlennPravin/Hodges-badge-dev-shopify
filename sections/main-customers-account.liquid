<script>
  (function () {
    var hash = (window.location.hash || "").replace("#", "");
    var params = new URLSearchParams(window.location.search);
    if (params.get("order_name")) {
      document.documentElement.setAttribute("data-account-order", "");
      document.documentElement.setAttribute("data-account-order-loading", params.get("order_name"));
      document.body.classList.add("account-page-2--orders", "account-page-2--order-detail");
      if (!document.querySelector(".account-order-detail-loading")) {
        var orderLoader = document.createElement("div");
        orderLoader.className = "account-order-detail-loading";
        orderLoader.setAttribute("role", "status");
        orderLoader.setAttribute("aria-label", "Loading order");
        orderLoader.innerHTML = '<span class="account-orders-loading__spinner"></span>';
        document.body.appendChild(orderLoader);
      }
    } else if (hash === "addresses" || hash === "profile") {
      document.documentElement.setAttribute("data-account-tab", hash);
    }
  })();
</script>
<style>
  html[data-account-tab="addresses"] .account-page-2-orders-content,
  html[data-account-tab="profile"] .account-page-2-orders-content {
    display: none !important;
  }

  .account-page-2-addresses-section,
  .shopify-section:has(.account-page-2-addresses-section) {
    display: none !important;
  }

  html[data-account-order] .account-orders-view,
  html[data-account-order] .account-page-2-panel--orders,
  html[data-account-order] .account-page-2-panel--addresses {
    display: none !important;
  }

  html[data-account-order] .account-page-2-order-details,
  html[data-account-order] .account-page-2-order-detail {
    display: block !important;
  }

  html[data-account-order-loading] .account-page-2-order-details,
  html[data-account-order-loading] .account-page-2-order-detail,
  html[data-account-order-loading] .account-page-2-order-detail.is-active {
    display: none !important;
  }

  .account-order-detail-loading {
    display: none;
  }

  html[data-account-order-loading] .account-order-detail-loading {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 30;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.92);
  }

  .account-orders-view.is-counting .account-orders-view__content {
    display: none;
  }

  .account-orders-view:not(.is-counting) .account-orders-loading {
    display: none;
  }

  .account-orders-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }

  .account-orders-loading__spinner {
    width: 48px;
    height: 48px;
    border: 4px solid #e6e8eb;
    border-top-color: #1c3f95;
    border-radius: 50%;
    animation: account-orders-spin 0.8s linear infinite;
  }

  @keyframes account-orders-spin {
    to { transform: rotate(360deg); }
  }
</style>
<style>
  .slideshow-container {
    max-width: 600px;
    margin: auto;
    overflow: hidden;
    position: relative;
  }

  .address-slide {
    display: none;
  }

  .prev, .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 24px;
  }

  .prev {
    left: 10px;
  }

  .next {
    right: 10px;
  }
</style>
<section data-section-id="{{ section.id }}" data-section-type="account">
  <div class="container container--flush">
    <div class="page__sub-header">
      <nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb">
        <ol class="breadcrumb__list" role="list">
          <li class="breadcrumb__item">
            <a class="breadcrumb__link link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a> {%- render 'icon', icon: 'arrow-right' -%}
          </li>

          <li class="breadcrumb__item">
            <a class="breadcrumb__link link" href="{{ routes.account_url }}">{{ 'general.breadcrumb.account' | t }}</a> {%- render 'icon', icon: 'arrow-right' -%}
          </li>

          <li class="breadcrumb__item">
            <span class="breadcrumb__link" aria-current="page">{{ 'customer.general.orders' | t }}</span>
          </li>
        </ol>
      </nav>
    </div>

  <div class="layout">
    <div class="layout__section layout__section--secondary">
      <div class="card card--sticky hidden-pocket">
        <div class="card__section card__section--tight">
          <div class="card__linklist">
            {%- if customer.addresses.size > 1 -%}
                <div class="slideshow-container">
                {%- for address in customer.addresses -%}
                  <div class="address-slide">
                    <div class="address-list__item">
                      <div class="address-list__item-top">
                        {% for item in  customer.metafields.CustomerInfo.osasId %}
                          {%- if address.id == item.defaultAddress_id -%}
                            <span class="line-item__price"> Customer Id: {{ item.osasId }}</span>
                            {% break %} 
                          {%- endif -%}
                        {%- endfor -%}
                        {{- address | format_address -}}
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
                
                <a class="prev" onclick="changeSlide(-1)">&#10094;</a>
                <a class="next" onclick="changeSlide(1)">&#10095;</a>
              </div>              
            {%- else -%}
                {% for item in  customer.metafields.CustomerInfo.osasId %}
                    {%- if customer.default_address.id == item.defaultAddress_id -%}
                      <span class="line-item__price"> Customer Id: {{ item.osasId }}</span>
                    {%- elsif address.id == item.defaultAddress_id -%}
                          <span class="line-item__price"> Customer Id: {{ item.osasId }}</span>
                    {%- endif -%}   
                {%- endfor -%}
            {%- endif -%}  
          
            <a href="/pages/account-page#profile" class="card__linklist-item link" data-account-profile-link>My profile</a>
            <a href="{{ routes.account_url }}" class="card__linklist-item link text--strong">{{ 'customer.general.orders' | t }}</a>
            <a href="/pages/account-page#addresses" class="card__linklist-item link">{{ 'customer.general.addresses' | t }}</a>
            <a href="/pages/tax-details" class="card__linklist-item link">My tax-Exempt</a>
            <a href="{{ routes.account_logout_url }}" class="card__linklist-item link" data-no-instant>{{ 'customer.general.logout' | t }}</a>
          </div>

        </div>
      </div>

        <div class="value-picker-wrapper hidden-tablet-and-up">
          <button class="value-picker-button value-picker-button--pill" aria-haspopup="true" aria-expanded="false" aria-controls="account-selector" data-action="open-value-picker">
            {{- 'customer.general.orders' | t -}} {%- render 'icon', icon: 'arrow-bottom' -%}
          </button>

          <div id="account-selector" class="value-picker" aria-hidden="true">
            <div class="value-picker__inner">
              <header class="value-picker__header">
                <span class="value-picker__title text--strong">{{ 'customer.general.my_account' | t }}</span>
                <button class="value-picker__close" data-action="close-value-picker" aria-controls="account-selector" aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
              </header>

              <div class="value-picker__choice-list">
                <a href="/pages/account-page#profile" class="value-picker__choice-item" data-account-profile-link>My profile {% render 'icon', icon: 'check-2' %}</a>
                <a href="{{ routes.account_url }}" class="value-picker__choice-item is-selected">{{ 'customer.general.orders' | t }} {% render 'icon', icon: 'check-2' %}</a>
                <a href="/pages/account-page#addresses" class="value-picker__choice-item">{{ 'customer.general.addresses' | t }} {% render 'icon', icon: 'check-2' %}</a>
                 <a href="/pages/tax-details" class="card__linklist-item link">My tax-Exempt {% render 'icon', icon: 'check-2' %}</a>
                <a href="{{ routes.account_logout_url }}" class="value-picker__choice-item" data-no-instant>{{ 'customer.general.logout' | t }} {% render 'icon', icon: 'check-2' %}</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="layout__section account-page-2-orders-content">
        <div class="card">
          {%- if customer == blank -%}
            <div class="card__section card__section--tight">
              <h1 class="heading h1">{{ 'customer.general.orders' | t }}</h1>
            </div>
            <div class="card__section">
              <div class="empty-state empty-state--extra-tight">
                <div class="empty-state__icon">
                  {%- render 'icon', icon: 'package' -%}
                  <span class="empty-state__count">0</span>
                </div>

                <p class="empty-state__icon-description">{{ 'customer.general.no_orders' | t }}</p>

                <div class="empty-state__button-container">
                  <a href="{{ routes.all_products_collection_url }}" class="empty-state__button button button--primary">{{ 'customer.general.no_orders_button' | t }}</a>
                </div>
              </div>
            </div>
          {%- else -%}
            {%- comment -%}
              orders_count and paginate.items skip test orders, so a customer
              with 3 paid and 45 test orders showed "3" and no page links.
              Page through every order, 20 at a time. The heading total is filled
              in by script. Line items stay unloaded so Liquid memory holds.
            {%- endcomment -%}
            {%- paginate customer.orders by 20 -%}
              {%- comment -%}
                routes.storefront_login_url includes return_to for this page, query string included.
                content_for_header is already consumed in theme.liquid, so it cannot be read again here.
              {%- endcomment -%}
              {%- assign account_login_return = routes.storefront_login_url | url_decode | url_decode -%}
              {%- assign requested_order_name = account_requested_order_name | default: '' | remove: '#' | strip -%}
              {%- if account_login_return contains 'order_name=' -%}
                {%- assign requested_order_name = account_login_return | split: 'order_name=' | last | split: '&' | first | split: '#' | first | url_decode | remove: '#' | strip -%}
              {%- endif -%}
              {%- if customer.orders.size == 0 and paginate.current_page == 1 -%}
                <div class="card__section card__section--tight">
                  <h1 class="heading h1">{{ 'customer.general.orders' | t }}</h1>
                </div>
                <div class="card__section">
                  <div class="empty-state empty-state--extra-tight">
                    <div class="empty-state__icon">
                      {%- render 'icon', icon: 'package' -%}
                      <span class="empty-state__count">0</span>
                    </div>

                    <p class="empty-state__icon-description">{{ 'customer.general.no_orders' | t }}</p>

                    <div class="empty-state__button-container">
                      <a href="{{ routes.all_products_collection_url }}" class="empty-state__button button button--primary">{{ 'customer.general.no_orders_button' | t }}</a>
                    </div>
                  </div>
                </div>
              {%- else -%}
                {%- assign orders_pending = false -%}
                {%- if requested_order_name == blank -%}
                  {%- if customer.orders.size == 20 or paginate.current_page > 1 -%}
                    {%- assign orders_pending = true -%}
                  {%- endif -%}
                {%- endif -%}
                <div class="account-orders-view{% if orders_pending %} is-counting{% endif %}">
                <div class="account-orders-loading" role="status" aria-live="polite">
                  <span class="account-orders-loading__spinner"></span>
                </div>
                <div class="account-orders-view__content">
                <div
                  class="card__header card__header--tight"
                  data-account-orders-meta
                  data-page="{{ paginate.current_page }}"
                  data-page-size="20"
                  data-on-page="{{ customer.orders.size }}"
                >
                  <h1 class="heading h1">{{ 'customer.general.orders' | t }} <span data-account-orders-count>{% unless orders_pending %}({{ customer.orders.size }}){% endunless %}</span></h1>
                </div>

                {%- if customer.orders.size == 0 -%}
                  <div class="card__section">
                    <p>{{ 'customer.general.no_orders' | t }}</p>
                    <a class="link" href="{{ request.path }}">{{ 'general.pagination.previous_page' | t }}</a>
                  </div>
                {%- else -%}
                  <div class="table-wrapper">
                    <table class="table table--loose">
                      <thead>
                        <tr>
                          <th>{{ 'customer.order.order' | t }}</th>
                          <th>{{ 'customer.order.date' | t }}</th>
                          <th>{{ 'customer.order.payment_status' | t }}</th>
                          <th>{{ 'customer.order.fulfillment_status' | t }}</th>
                          <th class="table__cell--right">{{ 'customer.order.total' | t }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {%- for order in customer.orders -%}
                          {%- assign order_key = order.name | remove: '#' -%}
                          <tr data-account-order-row>
                            <td><a href="{{ request.path }}?order_name={{ order_key }}{% if paginate.current_page > 1 %}&page={{ paginate.current_page }}{% endif %}" data-order-page="{{ paginate.current_page }}" class="link link--accented">{{ order.name }}</a></td>
                            <td>{{ order.created_at | date: format: 'month_day_year' }}</td>
                            {%- if order.metafields.payment.status -%}
                              <td>{{ order.metafields.payment.status }}</td>
                            {%- else -%}
                              <td>{{ order.financial_status_label }}</td>
                            {%- endif -%}
                            <td>{{ order.fulfillment_status_label }}</td>
                            <td class="table__cell--right">{{ order.total_price | money }}</td>
                          </tr>
                        {%- endfor -%}
                      </tbody>
                    </table>
                  </div>
                {%- endif -%}

                <div
                  class="pagination"
                  data-account-orders-pagination
                  data-label-prev="{{ 'general.pagination.previous_page' | t | escape }}"
                  data-label-next="{{ 'general.pagination.next_page' | t | escape }}"
                  {% if customer.orders.size < 20 and paginate.current_page == 1 %}hidden{% endif %}
                >
                  <div class="pagination__inner">
                    {%- if paginate.current_page > 1 -%}
                      <a class="pagination__prev link" data-page="{{ paginate.current_page | minus: 1 }}" href="{{ request.path }}?page={{ paginate.current_page | minus: 1 }}">
                        {%- render 'icon', icon: 'arrow-left' -%} {{ 'general.pagination.previous_page' | t }}
                      </a>
                    {%- endif -%}
                    {%- if customer.orders.size == 20 -%}
                      <a class="pagination__next link" data-page="{{ paginate.current_page | plus: 1 }}" href="{{ request.path }}?page={{ paginate.current_page | plus: 1 }}">
                        {{ 'general.pagination.next_page' | t }} {%- render 'icon', icon: 'arrow-right' -%}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
                </div>
                </div>
                {%- if requested_order_name != blank -%}
                  {%- for order in customer.orders -%}
                    {%- assign order_key = order.name | remove: '#' | strip -%}
                    {%- assign order_number_key = order.order_number | append: '' | strip -%}
                    {%- if order_key == requested_order_name or order_number_key == requested_order_name -%}
                      {%- render 'account-page-2-order-detail', order: order -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endif -%}
            {%- endpaginate -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  let slideIndex = 0;
  showSlide(slideIndex);

  function showSlide(index) {
    const slides = document.getElementsByClassName("address-slide");
    
    // Hide all slides
    for (let i = 0; i < slides.length; i++) {
      slides[i].style.display = "none";
    }

    // Ensure index is within valid range
    if (index >= slides.length) {
      slideIndex = 0;
    } else if (index < 0) {
      slideIndex = slides.length - 1;
    }

    // Display the current slide
    slides[slideIndex].style.display = "block";
  }

  function changeSlide(offset) {
    showSlide(slideIndex += offset);
  }
</script>
<script>
  (function () {
    var meta = document.querySelector("[data-account-orders-meta]");
    if (!meta) return;

    var pageSize = parseInt(meta.getAttribute("data-page-size"), 10) || 20;
    var currentPage = parseInt(meta.getAttribute("data-page"), 10) || 1;
    var onPage = document.querySelectorAll("[data-account-order-row]").length;
    if (!onPage) onPage = parseInt(meta.getAttribute("data-on-page"), 10) || 0;
    var countEl = document.querySelector("[data-account-orders-count]");
    var pager = document.querySelector("[data-account-orders-pagination]");
    var section = meta.closest("[data-section-id]");
    var sectionId = section ? section.getAttribute("data-section-id") : "";
    var seen = {};
    var currentLink = document.querySelector("[data-account-order-row] a");
    if (currentLink) seen[currentLink.textContent.trim()] = true;

    function setCount(total) {
      if (countEl) countEl.textContent = "(" + total + ")";
    }

    function pageHref(page) {
      var url = new URL(window.location.href);
      url.hash = "";
      url.searchParams.delete("order_name");
      url.searchParams.delete("address_page");
      if (page > 1) url.searchParams.set("page", String(page));
      else url.searchParams.delete("page");
      return url.pathname + url.search;
    }

    function renderPager(total) {
      if (!pager) return;
      var pages = Math.ceil(total / pageSize);
      if (pages <= 1) {
        pager.hidden = true;
        pager.innerHTML = "";
        return;
      }

      var prevLabel = pager.getAttribute("data-label-prev") || "Previous";
      var nextLabel = pager.getAttribute("data-label-next") || "Next";
      var html = '<div class="pagination__inner">';
      if (currentPage > 1) {
        html += '<a class="pagination__prev link" data-page="' + (currentPage - 1) + '" href="' + pageHref(currentPage - 1) + '">' + prevLabel + "</a>";
      }
      html += '<div class="pagination__nav pagination_items_nav">';
      for (var i = 1; i <= pages; i++) {
        if (i === currentPage) {
          html += '<span class="pagination__nav-item is-active">' + i + "</span>";
        } else {
          html += '<a class="pagination__nav-item link" data-page="' + i + '" href="' + pageHref(i) + '">' + i + "</a>";
        }
      }
      html += "</div>";
      html += '<span class="pagination__page-count">Page ' + currentPage + " / " + pages + "</span>";
      if (currentPage < pages) {
        html += '<a class="pagination__next link" data-page="' + (currentPage + 1) + '" href="' + pageHref(currentPage + 1) + '">' + nextLabel + "</a>";
      }
      html += "</div>";
      pager.hidden = false;
      pager.innerHTML = html;
    }

    function finish(total) {
      setCount(total);
      renderPager(total);
      var view = document.querySelector(".account-orders-view");
      if (view) view.classList.remove("is-counting");
    }

    if (onPage < pageSize && currentPage === 1) {
      finish(onPage);
      return;
    }

    var total = 0;
    var page = 1;

    function step() {
      if (page > 40) {
        finish(total);
        return;
      }
      if (page === currentPage) {
        total += onPage;
        if (onPage < pageSize) {
          finish(total);
          return;
        }
        page += 1;
        step();
        return;
      }

      var url = window.location.pathname + "?section_id=" + encodeURIComponent(sectionId) + "&page=" + page;
      fetch(url, { credentials: "same-origin", cache: "no-store" })
        .then(function (response) { return response.text(); })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, "text/html");
          var link = doc.querySelector("[data-account-order-row] a");
          var name = link ? link.textContent.trim() : "";
          var count = doc.querySelectorAll("[data-account-order-row]").length;
          if (!count || (name && seen[name])) {
            finish(total);
            return;
          }
          seen[name] = true;
          total += count;
          if (count < pageSize) {
            finish(total);
            return;
          }
          page += 1;
          step();
        })
        .catch(function () {
          finish(total || onPage);
        });
    }

    step();
  })();
</script>

{% schema %}
{
  "name": "Account"
}
{% endschema %}